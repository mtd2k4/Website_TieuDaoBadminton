@model tieudaobadminton.ViewModels.AdminCreateUserVM
@{
    ViewData["Title"] = "Tạo tài khoản";
    var roles = ViewBag.Roles as List<string> ?? new();
}

<h3 class="mb-3">Tạo tài khoản</h3>

<form method="post" class="card p-4">
    @Html.AntiForgeryToken()
    <div class="text-danger">@Html.ValidationSummary()</div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input asp-for="Password" class="form-control" />
        <div class="small text-muted">Gợi ý: dùng User@123 hoặc đổi tùy ý</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Role</label>
        <select asp-for="Role" class="form-select">
            @foreach (var r in roles)
            {
                <option value="@r">@r</option>
            }
        </select>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-dark">Tạo</button>
        <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="Accounts" asp-action="Index">Quay lại</a>
    </div>
</form>

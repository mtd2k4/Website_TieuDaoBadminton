@model tieudaobadminton.ViewModels.AdminEditUserVM
@{
    ViewData["Title"] = "Chỉnh sửa & Phân quyền tài khoản";
    var roles = ViewBag.Roles as List<string> ?? new();
}

<div class="container-fluid py-2" style="max-width: 760px;">

    <div class="mb-3">
        <a asp-area="Admin" asp-controller="Accounts" asp-action="Index" class="text-decoration-none text-muted small fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản
        </a>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Err"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- CARD 1: THÔNG TIN & PHÂN QUYỀN -->
    <div class="card border-0 p-4 p-md-5 bg-white mb-4">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="admin-header-icon">
                <i class="bi bi-person-gear"></i>
            </div>
            <div>
                <h4 class="fw-black text-dark m-0">Cập Nhật Tài Khoản & Phân Quyền</h4>
                <small class="text-muted">Chỉnh sửa email, cấp quyền truy cập hệ thống hoặc khóa tài khoản</small>
            </div>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="text-danger small mb-3">@Html.ValidationSummary()</div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Địa chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control py-2" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Vai trò hệ thống (Role)</label>
                <select asp-for="Role" class="form-select py-2">
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
                <div class="small text-muted mt-1">
                    <i class="bi bi-shield-lock me-1"></i><strong>Admin:</strong> Toàn quyền quản trị • <strong>Staff:</strong> Nhân viên vận hành • <strong>Customer:</strong> Khách mua hàng
                </div>
            </div>

            <div class="p-3 rounded-4 bg-light border mb-4">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" asp-for="IsLocked" id="lockSwitch" />
                    <label class="form-check-label fw-bold text-danger" for="lockSwitch">
                        <i class="bi bi-lock-fill me-1"></i> Tạm khóa quyền đăng nhập của tài khoản này
                    </label>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a class="btn btn-light border rounded-pill px-4 fw-bold" asp-area="Admin" asp-controller="Accounts" asp-action="Index">
                    Quay lại
                </a>
                <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>

    <!-- CARD 2: ĐẶT LẠI MẬT KHẨU -->
    <div class="card border-0 p-4 bg-white border-start border-4 border-warning">
        <form method="post" asp-area="Admin" asp-controller="Accounts" asp-action="ResetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-key-fill text-warning fs-5"></i>
                <h6 class="fw-black text-dark m-0">Cấp Lại Mật Khẩu Khẩn Cấp (Reset Password)</h6>
            </div>
            <p class="small text-muted mb-3">
                Sử dụng khi nhân viên hoặc khách hàng quên mật khẩu đăng nhập.
            </p>
            <div class="row g-2">
                <div class="col-md-8">
                    <input class="form-control" name="newPassword" value="User@123" placeholder="Nhập mật khẩu mới..." required />
                </div>
                <div class="col-md-4 d-grid">
                    <button type="submit" class="btn btn-warning fw-bold rounded-pill text-dark">
                        <i class="bi bi-arrow-repeat me-1"></i> Đặt lại mật khẩu
                    </button>
                </div>
            </div>
        </form>
    </div>

</div>

@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var q = (string?)ViewBag.Q;
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h3 class="mb-0">Quản lý tài khoản</h3>
        <div class="text-muted small">Tạo nhân viên, quản lý khách hàng, khóa/mở khóa</div>
    </div>
    <a class="btn btn-dark" asp-area="Admin" asp-controller="Accounts" asp-action="Create">+ Tạo tài khoản</a>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-6">
        <input class="form-control" name="q" value="@q" placeholder="Tìm theo email/username..." />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-dark w-100">Tìm</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th style="width:220px;">Trạng thái</th>
                    <th style="width:180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var locked = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTimeOffset.Now;
                    <tr>
                        <td>
                            <div class="fw-semibold">@u.Email</div>
                            <div class="text-muted small">@u.Id</div>
                        </td>
                        <td>
                            @if (locked)
                            {
                                <span class="badge bg-danger">Đang khóa</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-outline-dark btn-sm"
                               asp-area="Admin" asp-controller="Accounts" asp-action="Edit" asp-route-id="@u.Id">Sửa</a>

                            <form class="d-inline" method="post"
                                  asp-area="Admin" asp-controller="Accounts" asp-action="Delete">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-danger btn-sm"
                                        onclick="return confirm('Xóa tài khoản này?')">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

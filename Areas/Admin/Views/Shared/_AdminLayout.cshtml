@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject tieudaobadminton.Data.ApplicationDbContext DbContext
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var pendingOrders = DbContext.Orders
        .Where(o => o.Status == "Pending")
        .OrderByDescending(o => o.CreatedAt)
        .Take(8)
        .ToList();
    var totalPendingCount = DbContext.Orders.Count(o => o.Status == "Pending");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tiêu Đao Admin Pro</title>

    <!-- Google Fonts: Be Vietnam Pro + Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrap">

        <!-- 1. LEFT SIDEBAR -->
        <aside class="admin-sidebar">
            <div class="admin-brand-header">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-brand-link">
                    <div class="admin-brand-logo">🏸</div>
                    <div>
                        <div class="admin-brand-title">TIÊU ĐAO SPORT</div>
                        <div class="admin-brand-badge">ADMIN CONTROL PANEL</div>
                    </div>
                </a>
            </div>

            <nav class="admin-nav-menu">
                <div class="admin-nav-group-title">QUẢN TRỊ KINH DOANH</div>

                <a class="admin-nav-item @(currentCtrl == "Home" ? "active" : "")"
                   asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill nav-icon"></i>
                    <span>Tổng quan (Dashboard)</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "Orders" ? "active" : "")"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-box-seam-fill nav-icon"></i>
                    <span>Quản lý Đơn hàng</span>
                    @if (totalPendingCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-auto">@totalPendingCount mới</span>
                    }
                </a>

                <a class="admin-nav-item @(currentCtrl == "Products" ? "active" : "")"
                   asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-bag-check-fill nav-icon"></i>
                    <span>Sản phẩm & Kho hàng</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "StockReceipts" && ViewContext.RouteData.Values["action"]?.ToString() != "Report" ? "active" : "")"
                   asp-area="Admin" asp-controller="StockReceipts" asp-action="Index">
                    <i class="bi bi-box-arrow-in-down nav-icon"></i>
                    <span>Nhập hàng & Nguồn gốc</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "StockReceipts" && ViewContext.RouteData.Values["action"]?.ToString() == "Report" ? "active" : "")"
                   asp-area="Admin" asp-controller="StockReceipts" asp-action="Report">
                    <i class="bi bi-graph-up-arrow nav-icon"></i>
                    <span>Báo cáo Lãi suất (%)</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "Categories" ? "active" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-folder2-open nav-icon"></i>
                    <span>Danh mục sản phẩm</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "Brands" ? "active" : "")"
                   asp-area="Admin" asp-controller="Brands" asp-action="Index">
                    <i class="bi bi-tag-fill nav-icon"></i>
                    <span>Thương hiệu</span>
                </a>

                <div class="admin-nav-group-title mt-3">NỘI DUNG & HỆ THỐNG</div>

                <a class="admin-nav-item @(currentCtrl == "News" ? "active" : "")"
                   asp-area="Admin" asp-controller="News" asp-action="Index">
                    <i class="bi bi-newspaper nav-icon"></i>
                    <span>Quản lý Cẩm nang</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "Contacts" ? "active" : "")"
                   asp-area="Admin" asp-controller="Contacts" asp-action="Index">
                    <i class="bi bi-envelope-paper-fill nav-icon"></i>
                    <span>Hộp thư liên hệ</span>
                </a>

                <a class="admin-nav-item @(currentCtrl == "Accounts" ? "active" : "")"
                   asp-area="Admin" asp-controller="Accounts" asp-action="Index">
                    <i class="bi bi-people-fill nav-icon"></i>
                    <span>Quản lý Tài khoản</span>
                </a>

                <div class="admin-nav-group-title mt-3">LỐI TẮT BÊN NGOÀI</div>

                <a class="admin-nav-item" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right nav-icon"></i>
                    <span>Xem website bán hàng</span>
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="admin-avatar">👤</div>
                        <div class="overflow-hidden">
                            <div class="admin-user-name text-truncate">@User?.Identity?.Name</div>
                            <small class="admin-role-badge">Quản trị viên</small>
                        </div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger p-1 rounded-circle" title="Đăng xuất" style="width: 32px; height: 32px;" onclick="return confirm('Bạn có chắc muốn đăng xuất?');">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- 2. MAIN CONTENT AREA -->
        <main class="admin-main">
            <!-- TOPBAR -->
            <div class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="fw-black text-dark m-0">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- CHUÔNG THÔNG BÁO ĐƠN HÀNG MỚI -->
                    <div class="dropdown">
                        <button class="btn btn-sm @(totalPendingCount > 0 ? "btn-danger" : "btn-outline-secondary") rounded-pill px-3 fw-bold position-relative d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell-fill"></i>
                            <span>Đơn hàng mới</span>
                            <span class="badge @(totalPendingCount > 0 ? "bg-white text-danger" : "bg-secondary text-white") rounded-pill">@totalPendingCount</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 mt-2" style="width: 340px; border-radius: 16px; overflow: hidden;">
                            <div class="p-3 bg-dark text-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold small">🔔 Thông báo đơn hàng chờ xử lý</span>
                                <span class="badge bg-danger rounded-pill">@totalPendingCount đơn</span>
                            </div>
                            <div style="max-height: 320px; overflow-y: auto;">
                                @if (pendingOrders.Count == 0)
                                {
                                    <div class="p-4 text-center text-muted small">
                                        ✓ Hiện không có đơn hàng mới nào đang chờ duyệt.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var ord in pendingOrders)
                                    {
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                                           class="dropdown-item p-3 border-bottom text-wrap">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-primary small">#DH@(ord.Id.ToString("D5"))</span>
                                                <small class="text-muted" style="font-size: 0.72rem;">@ord.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                            </div>
                                            <div class="fw-semibold text-dark small">@ord.FullName (@ord.Phone)</div>
                                            <div class="d-flex justify-content-between align-items-center mt-1">
                                                <span class="badge bg-warning text-dark" style="font-size: 0.7rem;">Chờ xác nhận</span>
                                                <span class="fw-bold text-danger small">@ord.Total.ToString("n0") đ</span>
                                            </div>
                                        </a>
                                    }
                                }
                            </div>
                            <div class="p-2 bg-light text-center border-top">
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="small fw-bold text-primary text-decoration-none">
                                    Xem tất cả đơn hàng →
                                </a>
                            </div>
                        </div>
                    </div>

                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold" target="_blank">
                        <i class="bi bi-shop me-1"></i> Xem cửa hàng ngoài shop
                    </a>
                    <div class="badge bg-dark rounded-pill px-3 py-2 text-white">
                        <span>👤 @User?.Identity?.Name</span>
                    </div>
                </div>
            </div>

            <!-- CONTENT BODY -->
            <div class="admin-content">
                @RenderBody()
            </div>
        </main>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

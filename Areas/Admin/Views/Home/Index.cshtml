@model tieudaobadminton.Areas.Admin.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Dashboard Tổng Quan";
}

<div class="admin-dashboard-wrapper">

    <!-- 1. EXECUTIVE HERO BANNER -->
    <div class="admin-hero-banner d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); font-size: 0.75rem; font-weight: 700; color: #38bdf8;">
                <i class="bi bi-activity"></i>
                <span>HỆ THỐNG VẬN HÀNH THỜI GIAN THỰC • @DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
            <h3 class="fw-black text-white m-0">
                Trung Tâm Điều Hành Quản Trị Tiêu Đao Sport
            </h3>
            <p class="m-0 mt-1 small" style="color: #cbd5e1; max-width: 620px;">
                Tổng hợp số liệu doanh thu, tiến độ xử lý đơn hàng, biến động tồn kho và phân tích tỷ suất lợi nhuận thực tế.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Pending"
               class="btn btn-warning rounded-pill px-3 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-dark">
                <i class="bi bi-hourglass-split"></i>
                <span>Đơn chờ duyệt (@Model.PendingOrdersCount)</span>
            </a>
            <a asp-area="Admin" asp-controller="StockReceipts" asp-action="Create"
               class="btn btn-outline-light rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-in-down"></i>
                <span>Nhập kho</span>
            </a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Create"
               class="btn btn-primary rounded-pill px-3 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                <span>Thêm sản phẩm</span>
            </a>
        </div>
    </div>

    <!-- 2. 4 HERO KPI METRICS -->
    <div class="row g-3 mb-4">

        <!-- KPI 1: DOANH THU THỰC TẾ -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white h-100 kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Tổng doanh thu hoàn tất</span>
                        <h4 class="fw-black text-success m-0 mt-1">@Model.TotalRevenue.ToString("N0") ₫</h4>
                    </div>
                    <div class="kpi-icon-badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="small text-muted pt-2 border-top mt-auto d-flex justify-content-between align-items-center">
                    <span>Doanh thu tháng này:</span>
                    <strong class="text-dark">@Model.MonthRevenue.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <!-- KPI 2: ĐƠN HÀNG MỚI CẦN DUYỆT -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white h-100 kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Tổng đơn đặt hàng</span>
                        <h4 class="fw-black text-dark m-0 mt-1">@Model.TotalOrders <small class="fs-6 text-muted fw-normal">đơn</small></h4>
                    </div>
                    <div class="kpi-icon-badge bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                </div>
                <div class="small text-muted pt-2 border-top mt-auto d-flex justify-content-between align-items-center">
                    <span>Trạng thái chờ duyệt:</span>
                    @if (Model.PendingOrdersCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill px-2 py-1">@Model.PendingOrdersCount đơn mới</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1"><i class="bi bi-check-lg me-1"></i>Đã xử lý hết</span>
                    }
                </div>
            </div>
        </div>

        <!-- KPI 3: KHO SẢN PHẨM & HÃNG -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white h-100 kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Danh mục hàng hóa</span>
                        <h4 class="fw-black text-dark m-0 mt-1">@Model.TotalProducts <small class="fs-6 text-muted fw-normal">sản phẩm</small></h4>
                    </div>
                    <div class="kpi-icon-badge bg-info bg-opacity-10 text-info">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
                <div class="small text-muted pt-2 border-top mt-auto d-flex justify-content-between">
                    <a asp-controller="Brands" asp-action="Index" class="text-decoration-none text-muted fw-semibold">
                        <i class="bi bi-tags-fill text-primary me-1"></i>@Model.TotalBrands thương hiệu
                    </a>
                    <span>•</span>
                    <a asp-controller="Categories" asp-action="Index" class="text-decoration-none text-muted fw-semibold">
                        <i class="bi bi-folder2-open text-warning me-1"></i>@Model.TotalCategories danh mục
                    </a>
                </div>
            </div>
        </div>

        <!-- KPI 4: KHÁCH HÀNG & BÀI VIẾT -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white h-100 kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">Tài khoản khách hàng</span>
                        <h4 class="fw-black text-dark m-0 mt-1">@Model.TotalCustomers <small class="fs-6 text-muted fw-normal">thành viên</small></h4>
                    </div>
                    <div class="kpi-icon-badge bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="small text-muted pt-2 border-top mt-auto d-flex justify-content-between align-items-center">
                    <span>Bài viết cẩm nang:</span>
                    <a asp-controller="News" asp-action="Index" class="text-decoration-none fw-bold text-dark">
                        @Model.TotalNewsPosts bài <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- 2.5 ĐỐI CHIẾU BÁN & NHẬP - TỶ SUẤT LÃI SUẤT -->
    <div class="admin-profit-strip mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-xl-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon-badge bg-success text-white shadow-sm">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <div class="fw-black text-dark fs-6">Đối Chiếu Bán & Nhập — Hiệu Quả Lãi Suất</div>
                        <div class="small text-muted">So sánh doanh thu thực thu và giá vốn xuất kho</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="row g-3 align-items-center text-sm-start">
                    <div class="col-6 col-md-3 border-start-md ps-md-3">
                        <span class="text-muted small d-block" style="font-size: 0.75rem;">Doanh thu bán hàng</span>
                        <strong class="text-primary fs-6">@Model.TotalRevenue.ToString("n0") đ</strong>
                    </div>
                    <div class="col-6 col-md-3 border-start ps-3">
                        <span class="text-muted small d-block" style="font-size: 0.75rem;">Giá vốn xuất bán</span>
                        <strong class="text-danger fs-6">@Model.TotalCostOfSoldGoods.ToString("n0") đ</strong>
                    </div>
                    <div class="col-6 col-md-3 border-start ps-3">
                        <span class="text-muted small d-block" style="font-size: 0.75rem;">Lợi nhuận gộp</span>
                        <strong class="text-success fs-6">+@Model.GrossProfit.ToString("n0") đ</strong>
                    </div>
                    <div class="col-6 col-md-3 border-start ps-3 d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <span class="text-muted small d-block" style="font-size: 0.75rem;">Biên lợi nhuận</span>
                            <span class="badge bg-success rounded-pill px-2 py-1 mt-1">+@Model.ProfitMarginPercent%</span>
                        </div>
                        <a asp-area="Admin" asp-controller="StockReceipts" asp-action="Report"
                           class="btn btn-sm btn-dark rounded-pill px-3 py-2 fw-bold flex-shrink-0" title="Xem báo cáo lãi suất chi tiết">
                            <i class="bi bi-bar-chart-steps me-1"></i> Chi tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. CHARTS ROW (DOANH THU 7 NGÀY & PHÂN BỔ THƯƠNG HIỆU) -->
    <div class="row g-4 mb-4">

        <!-- REVENUE CHART 7 DAYS (8 COLS) -->
        <div class="col-lg-8">
            <div class="card border-0 p-4 bg-white h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="fw-black text-dark m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-bar-chart-line-fill text-primary"></i>
                            <span>Biểu Đồ Doanh Thu & Lượng Đơn (7 Ngày Qua)</span>
                        </h5>
                        <small class="text-muted">Theo dõi biến động dòng tiền và tần suất đặt hàng trong tuần</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill small fw-bold">
                        <i class="bi bi-calendar3 me-1"></i> 7 Ngày gần nhất
                    </span>
                </div>
                <div style="height: 310px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- BRAND SHARE DOUGHNUT CHART (4 COLS) -->
        <div class="col-lg-4">
            <div class="card border-0 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-black text-dark m-0 d-flex align-items-center gap-2">
                                <i class="bi bi-pie-chart-fill text-info"></i>
                                <span>Tỷ Trọng Thương Hiệu</span>
                            </h5>
                            <small class="text-muted">Phân bổ mẫu mã theo hãng chính hãng</small>
                        </div>
                    </div>
                    <div style="height: 245px; position: relative;" class="d-flex align-items-center justify-content-center my-2">
                        <canvas id="brandChart"></canvas>
                    </div>
                </div>
                <div class="small text-muted text-center pt-3 border-top">
                    <i class="bi bi-check2-circle text-success me-1"></i> Đồng bộ trực tiếp từ danh mục kho hàng
                </div>
            </div>
        </div>

    </div>

    <!-- 4. RECENT ORDERS & TOP PRODUCTS (2 COLUMNS) -->
    <div class="row g-4">

        <!-- RECENT ORDERS (8 COLS) -->
        <div class="col-lg-8">
            <div class="card border-0 bg-white h-100 overflow-hidden">
                <div class="p-4 pb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                    <div>
                        <h5 class="fw-black text-dark m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-primary"></i>
                            <span>Đơn Hàng Vừa Phát Sinh</span>
                        </h5>
                        <small class="text-muted">Danh sách các đơn đặt hàng mới nhất cần kiểm tra và xác nhận</small>
                    </div>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-2 fw-bold">
                        Quản lý toàn bộ đơn <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (Model.RecentOrders == null || !Model.RecentOrders.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div class="fs-1 mb-2"><i class="bi bi-inbox"></i></div>
                        <div>Chưa có đơn hàng nào phát sinh.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">MÃ ĐƠN</th>
                                    <th>KHÁCH HÀNG</th>
                                    <th>THỜI GIAN ĐẶT</th>
                                    <th class="text-end">TỔNG TIỀN</th>
                                    <th class="text-center">TRẠNG THÁI</th>
                                    <th class="text-end pe-4">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.RecentOrders)
                                {
                                    var badgeStyle = o.Status switch
                                    {
                                        "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                        "Shipping" => "bg-info-subtle text-info-emphasis border border-info-subtle",
                                        "Done" => "bg-success-subtle text-success border border-success-subtle",
                                        "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };

                                    var statusIcon = o.Status switch
                                    {
                                        "Pending" => "bi-hourglass-split",
                                        "Shipping" => "bi-truck",
                                        "Done" => "bi-check-circle-fill",
                                        "Cancelled" => "bi-x-circle-fill",
                                        _ => "bi-circle"
                                    };

                                    var statusLabel = o.Status switch
                                    {
                                        "Pending" => "Chờ duyệt",
                                        "Shipping" => "Đang giao",
                                        "Done" => "Hoàn thành",
                                        "Cancelled" => "Đã hủy",
                                        _ => o.Status
                                    };

                                    var customerInitial = !string.IsNullOrWhiteSpace(o.FullName)
                                        ? o.FullName.Trim().Substring(0, 1).ToUpper()
                                        : "K";

                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-primary font-monospace">#@($"DH{o.Id:D5}")</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="admin-table-avatar">@customerInitial</div>
                                                <div>
                                                    <div class="fw-bold text-dark">@o.FullName</div>
                                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@o.Phone</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="small text-muted">
                                            <i class="bi bi-calendar2-event me-1"></i>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-end fw-black text-danger">
                                            @o.Total.ToString("N0") ₫
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @badgeStyle rounded-pill px-3 py-1 fw-bold">
                                                <i class="bi @statusIcon me-1"></i>@statusLabel
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@o.Id"
                                               class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold">
                                                Chi tiết <i class="bi bi-arrow-right-short"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- TOP PRODUCTS LEADERBOARD (4 COLS) -->
        <div class="col-lg-4">
            <div class="card border-0 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <h5 class="fw-black text-dark m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-award-fill text-warning"></i>
                            <span>Top Sản Phẩm Bán Chạy</span>
                        </h5>
                        <small class="text-muted">Xếp hạng theo sản lượng tiêu thụ</small>
                    </div>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="small text-primary fw-bold text-decoration-none">
                        Kho hàng <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="d-flex flex-column gap-3">
                    @{
                        int rank = 1;
                    }
                    @foreach (var p in Model.TopProducts)
                    {
                        var rankClass = rank == 1 ? "admin-rank-1" : (rank == 2 ? "admin-rank-2" : (rank == 3 ? "admin-rank-3" : "admin-rank-default"));
                        <div class="d-flex align-items-center gap-3 p-2 rounded-4 bg-light bg-opacity-50 border">
                            <span class="admin-rank-badge @rankClass">#@rank</span>
                            <img src="@(p.ImageUrl ?? "/img/demo/placeholder.jpg")"
                                 alt="@p.ProductName"
                                 class="rounded-3 flex-shrink-0 bg-white"
                                 style="width: 50px; height: 50px; object-fit: cover; border: 1px solid rgba(0,0,0,0.08);" />
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-dark text-truncate small" title="@p.ProductName">@p.ProductName</div>
                                <div class="d-flex align-items-center justify-content-between mt-1">
                                    <span class="text-danger fw-bold small">@p.Price.ToString("N0") ₫</span>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill small fw-bold">
                                        Đã bán: @p.TotalSold
                                    </span>
                                </div>
                            </div>
                        </div>
                        rank++;
                    }
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. REVENUE CHART (7 DAYS)
            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                const days = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDays));
                const revData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartRevenue));
                const countData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartOrderCounts));

                new Chart(revCtx, {
                    type: 'bar',
                    data: {
                        labels: days,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Doanh thu (₫)',
                                data: revData,
                                borderColor: '#2563eb',
                                backgroundColor: 'rgba(37, 99, 235, 0.12)',
                                pointBackgroundColor: '#2563eb',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.38,
                                yAxisID: 'y'
                            },
                            {
                                type: 'bar',
                                label: 'Số đơn hàng',
                                data: countData,
                                backgroundColor: 'rgba(15, 23, 42, 0.14)',
                                hoverBackgroundColor: 'rgba(15, 23, 42, 0.28)',
                                borderRadius: 8,
                                maxBarThickness: 32,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 12,
                                    usePointStyle: true,
                                    font: { family: 'inherit', weight: 'bold' }
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                padding: 12,
                                cornerRadius: 10,
                                callbacks: {
                                    label: function(context) {
                                        if (context.dataset.yAxisID === 'y') {
                                            return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.raw) + ' ₫';
                                        }
                                        return 'Đơn hàng: ' + context.raw + ' đơn';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return (value / 1000000).toFixed(1) + ' tr';
                                        if (value >= 1000) return (value / 1000).toFixed(0) + ' k';
                                        return value;
                                    }
                                },
                                grid: {
                                    color: 'rgba(148, 163, 184, 0.15)'
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: {
                                    drawOnChartArea: false,
                                },
                                ticks: {
                                    stepSize: 1
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }

            // 2. BRAND SHARE DOUGHNUT CHART
            const brandCtx = document.getElementById('brandChart');
            if (brandCtx) {
                const bLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrandLabels));
                const bCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrandCounts));

                new Chart(brandCtx, {
                    type: 'doughnut',
                    data: {
                        labels: bLabels,
                        datasets: [{
                            data: bCounts,
                            backgroundColor: [
                                '#2563eb',
                                '#f97316',
                                '#ef4444',
                                '#10b981',
                                '#8b5cf6',
                                '#64748b'
                            ],
                            borderWidth: 3,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 10,
                                    usePointStyle: true,
                                    padding: 14,
                                    font: { family: 'inherit', size: 11, weight: '600' }
                                }
                            }
                        },
                        cutout: '68%'
                    }
                });
            }
        });
    </script>
}

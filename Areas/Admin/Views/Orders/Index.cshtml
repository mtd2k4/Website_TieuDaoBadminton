@model List<tieudaobadminton.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
    var search = ViewBag.Search as string ?? "";
}

<div class="container-fluid py-2">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-header-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <h4 class="fw-black text-dark m-0">Quản Lý Đơn Đặt Hàng</h4>
                <div class="text-muted small">Kiểm duyệt đơn hàng mới, cập nhật tiến trình vận chuyển và in phiếu giao hàng</div>
            </div>
        </div>
    </div>

    <!-- ALERT MESSAGES -->
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Tổng số đơn hàng</div>
                        <div class="fs-3 fw-black text-dark mt-1">@ViewBag.TotalOrders <small class="fs-6 text-muted fw-normal">đơn</small></div>
                    </div>
                    <div class="kpi-icon-badge bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Đang chờ duyệt</div>
                        <div class="fs-3 fw-black text-warning mt-1">@ViewBag.PendingOrders <small class="fs-6 text-muted fw-normal">đơn</small></div>
                    </div>
                    <div class="kpi-icon-badge bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Đã giao thành công</div>
                        <div class="fs-3 fw-black text-success mt-1">@ViewBag.DoneOrders <small class="fs-6 text-muted fw-normal">đơn</small></div>
                    </div>
                    <div class="kpi-icon-badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 p-3 bg-white kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Doanh thu hoàn tất</div>
                        <div class="fs-4 fw-black text-primary mt-1">@(((decimal)ViewBag.TotalRevenue).ToString("n0")) đ</div>
                    </div>
                    <div class="kpi-icon-badge bg-info bg-opacity-10 text-info">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 p-3 mb-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm theo mã đơn (#DH...), họ tên, số điện thoại..." />
                    <button class="btn btn-dark px-4 fw-bold" type="submit">Tìm kiếm</button>
                </div>
            </div>

            <!-- Status Filter Pills -->
            <div class="col-lg-7 d-flex flex-wrap gap-2 justify-content-lg-end">
                <a class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(string.IsNullOrEmpty(currentStatus) ? "btn-dark" : "btn-light border")"
                   asp-action="Index" asp-route-search="@search">
                    <i class="bi bi-layers me-1"></i> Tất cả
                </a>
                <a class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(currentStatus == "Pending" ? "btn-warning text-dark fw-bold" : "btn-light border")"
                   asp-action="Index" asp-route-status="Pending" asp-route-search="@search">
                    <i class="bi bi-hourglass-split me-1"></i> Chờ duyệt (@ViewBag.PendingOrders)
                </a>
                <a class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(currentStatus == "Shipping" ? "btn-info text-dark fw-bold" : "btn-light border")"
                   asp-action="Index" asp-route-status="Shipping" asp-route-search="@search">
                    <i class="bi bi-truck me-1"></i> Đang giao
                </a>
                <a class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(currentStatus == "Done" ? "btn-success text-white fw-bold" : "btn-light border")"
                   asp-action="Index" asp-route-status="Done" asp-route-search="@search">
                    <i class="bi bi-check-circle me-1"></i> Hoàn thành
                </a>
                <a class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(currentStatus == "Cancelled" ? "btn-danger text-white fw-bold" : "btn-light border")"
                   asp-action="Index" asp-route-status="Cancelled" asp-route-search="@search">
                    <i class="bi bi-x-circle me-1"></i> Đã hủy
                </a>
            </div>
        </form>
    </div>

    <!-- ORDERS TABLE -->
    <div class="card border-0 overflow-hidden bg-white">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-2"><i class="bi bi-inbox"></i></div>
                <div class="fw-semibold">Không tìm thấy đơn hàng nào phù hợp điều kiện lọc.</div>
                <a asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill px-4 mt-3">Xem toàn bộ đơn hàng</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">MÃ ĐƠN</th>
                            <th>KHÁCH HÀNG</th>
                            <th>ĐỊA CHỈ GIAO NHẬN</th>
                            <th class="text-center">SỐ LƯỢNG</th>
                            <th class="text-end">TỔNG THANH TOÁN</th>
                            <th>THỜI GIAN ĐẶT</th>
                            <th class="text-center">TRẠNG THÁI</th>
                            <th class="text-end pe-4">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            var badgeClass = "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
                            var statusIcon = "bi-hourglass-split";
                            var statusText = "Chờ xử lý";

                            if (o.Status == "Shipping")
                            {
                                badgeClass = "bg-info-subtle text-info-emphasis border border-info-subtle";
                                statusIcon = "bi-truck";
                                statusText = "Đang giao";
                            }
                            else if (o.Status == "Done")
                            {
                                badgeClass = "bg-success-subtle text-success border border-success-subtle";
                                statusIcon = "bi-check-circle-fill";
                                statusText = "Hoàn thành";
                            }
                            else if (o.Status == "Cancelled")
                            {
                                badgeClass = "bg-danger-subtle text-danger border border-danger-subtle";
                                statusIcon = "bi-x-circle-fill";
                                statusText = "Đã hủy";
                            }

                            var initial = !string.IsNullOrWhiteSpace(o.FullName) ? o.FullName.Trim().Substring(0, 1).ToUpper() : "K";

                            <tr>
                                <td class="ps-4 fw-bold text-primary font-monospace">#@($"DH{o.Id:D5}")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="admin-table-avatar">@initial</div>
                                        <div>
                                            <div class="fw-bold text-dark">@o.FullName</div>
                                            <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@o.Phone</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-muted text-truncate" style="max-width: 240px;" title="@o.Address">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@o.Address
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 fw-semibold">
                                        @(o.Items?.Sum(i => i.Quantity) ?? 0) món
                                    </span>
                                </td>
                                <td class="text-end fw-black text-danger">
                                    @o.Total.ToString("n0") đ
                                </td>
                                <td class="small text-muted">
                                    @o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass rounded-pill px-3 py-1 fw-bold">
                                        <i class="bi @statusIcon me-1"></i>@statusText
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a class="btn btn-sm btn-light border rounded-pill px-2" asp-action="Print" asp-route-id="@o.Id" target="_blank" title="In phiếu giao hàng">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <a class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold" asp-action="Detail" asp-route-id="@o.Id">
                                            Chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

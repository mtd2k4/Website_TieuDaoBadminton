@model tieudaobadminton.Models.Order
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #DH{Model.Id:D5}";
    var orderCode = $"DH{Model.Id:D5}";

    var badgeClass = "bg-warning text-dark";
    var statusText = "Chờ xử lý";

    if (Model.Status == "Shipping")
    {
        badgeClass = "bg-info text-dark";
        statusText = "Đang giao";
    }
    else if (Model.Status == "Done")
    {
        badgeClass = "bg-success text-white";
        statusText = "Hoàn thành";
    }
    else if (Model.Status == "Cancelled")
    {
        badgeClass = "bg-danger text-white";
        statusText = "Đã hủy";
    }
}

<div class="container-fluid py-3">

    <!-- BREADCRUMB & BACK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
            ← Quay lại danh sách đơn
        </a>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm">
                🖨️ In Phiếu Giao Hàng
            </a>
            <span class="text-muted small">Mã đơn:</span>
            <span class="badge bg-dark fs-6 font-monospace">#@orderCode</span>
            <span class="badge @badgeClass fs-6 rounded-pill px-3">@statusText</span>
        </div>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✓ @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: ORDER ITEMS TABLE (8 COLS) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3">📦 Danh sách sản phẩm trong đơn</h5>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>SẢN PHẨM</th>
                                <th>PHÂN LOẠI</th>
                                <th class="text-center">SỐ LƯỢNG</th>
                                <th class="text-end">ĐƠN GIÁ</th>
                                <th class="text-end">THÀNH TIỀN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@item.ProductName</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Size) || !string.IsNullOrWhiteSpace(item.Color))
                                        {
                                            <span class="badge bg-light text-muted border">
                                                @(item.Size ?? "-") / @(item.Color ?? "-")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Tiêu chuẩn</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">x@(item.Quantity)</td>
                                    <td class="text-end text-muted">@item.UnitPrice.ToString("n0") đ</td>
                                    <td class="text-end fw-bold text-dark">@((item.UnitPrice * item.Quantity).ToString("n0")) đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <th colspan="4" class="text-end fs-6">TỔNG TIỀN ĐƠN HÀNG:</th>
                                <th class="text-end text-danger fs-5 fw-bold">@Model.Total.ToString("n0") đ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- RIGHT: CUSTOMER INFO & STATUS UPDATE (4 COLS) -->
        <div class="col-lg-4">
            <!-- 1. CẬP NHẬT TRẠNG THÁI ĐƠN -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3">⚙️ Cập nhật trạng thái</h5>

                <form method="post" asp-action="UpdateStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CHỌN TRẠNG THÁI MỚI</label>
                        <select name="newStatus" class="form-select rounded-3 py-2 fw-semibold">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xử lý (Pending)</option>
                            <option value="Shipping" selected="@(Model.Status == "Shipping")">Đang giao hàng (Shipping)</option>
                            <option value="Done" selected="@(Model.Status == "Done")">Đã hoàn thành (Done)</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy (Cancelled)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 fw-bold">
                        Lưu trạng thái
                    </button>
                </form>

                <!-- Quick Action Buttons -->
                <div class="mt-3 pt-3 border-top d-flex flex-column gap-2">
                    <small class="text-muted fw-bold">THAO TÁC NHANH:</small>
                    <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary w-100 rounded-pill fw-bold">
                        🖨️ In Phiếu Giao Hàng (A4/A5)
                    </a>
                    @if (Model.Status == "Pending")
                    {
                        <form method="post" asp-action="UpdateStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="Shipping" />
                            <button class="btn btn-sm btn-outline-info w-100 rounded-pill fw-bold text-dark">
                                🚚 Chuyển sang "Đang giao"
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Shipping")
                    {
                        <form method="post" asp-action="UpdateStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="newStatus" value="Done" />
                            <button class="btn btn-sm btn-success w-100 rounded-pill fw-bold">
                                ✓ Xác nhận "Giao thành công"
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- 2. THÔNG TIN GIAO HÀNG -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">👤 Thông tin khách nhận</h5>

                <div class="mb-3">
                    <div class="text-muted small">Họ và tên:</div>
                    <div class="fw-bold text-dark fs-6">@Model.FullName</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Số điện thoại:</div>
                    <div class="fw-bold text-primary fs-6">
                        <a href="tel:@Model.Phone" class="text-decoration-none">📞 @Model.Phone</a>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Địa chỉ nhận hàng:</div>
                    <div class="fw-semibold text-dark">@Model.Address</div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Thời gian đặt hàng:</div>
                    <div class="text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                </div>

                <!-- Xóa đơn nếu đã hủy -->
                @if (Model.Status == "Cancelled")
                {
                    <div class="pt-3 border-top">
                        <form method="post" asp-action="Delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-bold">
                                🗑️ Xóa đơn hàng đã hủy
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

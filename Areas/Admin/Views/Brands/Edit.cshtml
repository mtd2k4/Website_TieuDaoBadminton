@model tieudaobadminton.Models.Brand
@{
    ViewData["Title"] = $"Chỉnh sửa thương hiệu #{Model.Id}";
}

<div class="container-fluid py-3" style="max-width: 760px;">

    <!-- BACK -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại thương hiệu
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="fs-2 text-primary"><i class="bi bi-pencil-square"></i></div>
            <div>
                <h4 class="fw-black text-dark m-0">Chỉnh sửa thương hiệu: @Model.Name</h4>
                <div class="text-muted small">Cập nhật tên hãng sản xuất cầu lông</div>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold text-dark">Tên thương hiệu <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control rounded-3 py-2" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">Hủy bỏ</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">
                    <i class="bi bi-check-lg me-1"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>

</div>

@model tieudaobadminton.Models.Category
@{
    ViewData["Title"] = $"Chỉnh sửa danh mục #{Model.Id}";
}

<div class="container-fluid py-3" style="max-width: 760px;">

    <!-- BACK -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">
            ← Quay lại danh mục
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="fs-2 text-primary">✏️</div>
            <div>
                <h4 class="fw-black text-dark m-0">Chỉnh sửa danh mục: @Model.Name</h4>
                <div class="text-muted small">Cập nhật tên hoặc slug phân loại sản phẩm</div>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold text-dark">Tên danh mục <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control rounded-3 py-2" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Slug" class="form-label fw-bold text-dark">Slug đường dẫn</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">/</span>
                    <input asp-for="Slug" class="form-control rounded-end-3 py-2" />
                </div>
                <small class="text-muted">Slug là đường link URL thân thiện với công cụ tìm kiếm.</small>
                <span asp-validation-for="Slug" class="text-danger small d-block"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">Hủy bỏ</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">
                    ✓ Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>

</div>

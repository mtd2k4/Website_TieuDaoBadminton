@model List<tieudaobadminton.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục sản phẩm";
}

<div class="container-fluid py-3">

    <!-- HEADER & BUTTONS -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-header-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-folder2-open"></i>
            </div>
            <div>
                <h4 class="fw-black text-dark m-0">Danh mục sản phẩm</h4>
                <div class="text-muted small">Quản lý các nhóm sản phẩm (Vợt, Giày, Quần áo, Cước, Phụ kiện...)</div>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATS SUMMARY -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card kpi-card border-0 shadow-sm p-3 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">TỔNG SỐ DANH MỤC</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.Count <small class="fs-6 text-muted fw-normal">nhóm</small></div>
                    </div>
                    <div class="kpi-icon-badge bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card kpi-card border-0 shadow-sm p-3 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold">TỔNG SẢN PHẨM PHÂN LOẠI</div>
                        <div class="fs-3 fw-bold text-primary mt-1">@Model.Sum(c => c.Products.Count) <small class="fs-6 text-muted fw-normal">sản phẩm</small></div>
                    </div>
                    <div class="kpi-icon-badge bg-primary bg-opacity-10 text-primary fs-4">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1"><i class="bi bi-folder2-open"></i></div>
                <div class="mt-2">Chưa có danh mục nào trong hệ thống.</div>
                <a asp-action="Create" class="btn btn-outline-dark rounded-pill px-4 mt-3">Thêm danh mục đầu tiên</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>TÊN DANH MỤC</th>
                            <th>SLUG ĐƯỜNG DẪN</th>
                            <th class="text-center">SỐ SẢN PHẨM</th>
                            <th class="text-end pe-4" style="width: 220px;">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted font-monospace">#@cat.Id</td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@cat.Name</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">/@cat.Slug</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">
                                        @cat.Products.Count sản phẩm
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        @if (cat.Products.Count == 0)
                                        {
                                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                                    <i class="bi bi-trash me-1"></i> Xóa
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-light text-muted rounded-pill px-3 border" disabled title="Không thể xóa khi còn sản phẩm">
                                                <i class="bi bi-lock me-1"></i> Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@model List<tieudaobadminton.Models.Product>
@{
    ViewData["Title"] = "Danh sách yêu thích - Tiêu Đao Badminton";
}

<div class="py-5 bg-light" style="min-height: 85vh;">
    <div class="container" style="max-width: 1100px;">
        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Danh sách yêu thích</li>
            </ol>
        </nav>

        <!-- PAGE HEADER -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="fw-black h3 mb-1">❤️ Sản Phẩm Yêu Thích Của Bạn</h1>
                <p class="text-muted mb-0">
                    @(Model.Count > 0 ? $"Bạn đang lưu {Model.Count} sản phẩm quan tâm trong danh sách." : "Lưu lại những món đồ cầu lông bạn yêu thích để tiện theo dõi giá và mua sắm sau.")
                </p>
            </div>
            
            @if (Model.Count > 0)
            {
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold btn-sm px-3">
                        🛍️ Xem thêm sản phẩm
                    </a>
                    <form asp-action="Clear" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ danh sách yêu thích?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger rounded-pill fw-bold btn-sm px-3">
                            🗑️ Xóa tất cả
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- EMPTY STATE -->
        @if (Model == null || Model.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white mb-5">
                <div class="display-3 mb-3">🤍</div>
                <h4 class="fw-bold mb-2">Danh sách yêu thích đang trống!</h4>
                <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
                    Bạn chưa lưu sản phẩm nào. Hãy nhấn vào biểu tượng trái tim <strong>🤍</strong> trên mỗi cây vợt, đôi giày hoặc phụ kiện để lưu lại nhé!
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                        Khám phá sản phẩm ngay
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- PRODUCT GRID -->
            <div class="row g-3 g-md-4 mb-5">
                @foreach (var p in Model)
                {
                    var discountPercent = 0;
                    if (p.SalePrice.HasValue && p.Price > 0 && p.SalePrice < p.Price)
                    {
                        discountPercent = (int)Math.Round((1 - (p.SalePrice.Value / p.Price)) * 100);
                    }

                    <div class="col-6 col-md-4 col-lg-3" id="wishlist-item-@p.Id">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden d-flex flex-column justify-content-between position-relative" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                            <!-- Media Box -->
                            <div class="position-relative overflow-hidden" style="aspect-ratio: 1/1; background: #f8fafc;">
                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id" class="d-block w-100 h-100">
                                    <img src="@(p.MainImageUrl ?? "/img/demo/placeholder.jpg")" 
                                         alt="@p.Name" 
                                         class="w-100 h-100 object-fit-cover" 
                                         loading="lazy" />
                                </a>

                                <!-- Badges -->
                                <div class="position-absolute top-0 start-0 m-2 d-flex flex-column gap-1">
                                    @if (!string.IsNullOrWhiteSpace(p.Brand?.Name))
                                    {
                                        <span class="badge bg-dark text-white rounded-pill px-2 py-1 small fw-bold">@p.Brand.Name</span>
                                    }
                                    @if (discountPercent > 0)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-2 py-1 small fw-bold">-@discountPercent%</span>
                                    }
                                </div>

                                <!-- Remove button -->
                                <form asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-white rounded-circle shadow-sm border p-0 d-flex align-items-center justify-content-center" 
                                            style="width: 34px; height: 34px; background: rgba(255,255,255,0.9);" 
                                            title="Xóa khỏi yêu thích">
                                        ❌
                                    </button>
                                </form>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <div class="text-muted small mb-1">@(p.Category?.Name ?? "Cầu lông")</div>
                                    <h6 class="fw-bold text-dark mb-2 text-truncate-2" style="min-height: 40px;" title="@p.Name">
                                        <a asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id" class="text-dark text-decoration-none">
                                            @p.Name
                                        </a>
                                    </h6>

                                    <div class="d-flex align-items-baseline gap-2 mb-3">
                                        @if (p.SalePrice.HasValue)
                                        {
                                            <span class="fs-6 fw-bold text-danger">@p.SalePrice.Value.ToString("n0") đ</span>
                                            <span class="text-muted small text-decoration-line-through">@p.Price.ToString("n0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="fs-6 fw-bold text-dark">@p.Price.ToString("n0") đ</span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@p.Id" 
                                       class="btn btn-danger btn-sm rounded-pill fw-bold w-100 py-2">
                                        Xem chi tiết & Mua
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- PRO TIP CARD -->
        <div class="card border-0 rounded-4 p-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fs-4">💡</span>
                        <h5 class="fw-bold mb-0 text-white">Bạn đang phân vân giữa các cây vợt?</h5>
                    </div>
                    <p class="text-light opacity-75 small mb-0">
                        Sử dụng ngay hệ thống tư vấn thông minh để so sánh thông số kỹ thuật (độ dẻo đũa, điểm cân bằng, trọng lượng) phù hợp chuẩn xác với thể lực cổ tay của bạn.
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="/Tu-Van-Chon-Vot" class="btn btn-danger rounded-pill fw-bold px-4">
                        ⚡ Thử Tư Vấn AI Ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.text-truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

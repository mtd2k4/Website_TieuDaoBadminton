@model List<tieudaobadminton.Models.Order>
@{
    ViewData["Title"] = "Tra cứu đơn hàng - Tiêu Đao Badminton";
    string keyword = ViewBag.Keyword as string ?? "";
    bool hasSearched = ViewBag.HasSearched as bool? ?? false;
}

<div class="py-5 bg-light" style="min-height: 80vh;">
    <div class="container" style="max-width: 960px;">
        <!-- PAGE HEADER -->
        <div class="text-center mb-5">
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold mb-2">
                <i class="bi bi-box-seam-fill me-1"></i>KIỂM TRA TIẾN ĐỘ GIAO HÀNG
            </span>
            <h1 class="fw-black display-6 mb-2">Tra Cứu Trực Tuyến Đơn Hàng</h1>
            <p class="text-muted">Nhập mã đơn hàng hoặc số điện thoại bạn đã dùng khi đặt hàng để xem lộ trình vận chuyển.</p>
        </div>

        <!-- SEARCH BOX -->
        <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-5 bg-white">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-9">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="keyword" value="@keyword" 
                                   class="form-control border-start-0 ps-0 fs-6" 
                                   placeholder="Nhập mã đơn hàng (VD: 1, 1024) hoặc số điện thoại (0901...)" required />
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold rounded-3 shadow-sm py-2">
                            Tra Cứu Ngay
                        </button>
                    </div>
                </div>
            </form>

            <div class="d-flex flex-wrap gap-3 mt-3 pt-3 border-top text-muted small">
                <span><i class="bi bi-lightbulb-fill text-warning me-1"></i><em>Mẹo: Bạn có thể nhập mã dạng <strong>#1024</strong>, <strong>DH1024</strong> hoặc số điện thoại người nhận.</em></span>
            </div>
        </div>

        <!-- SEARCH RESULTS -->
        @if (hasSearched)
        {
            if (Model != null && Model.Count > 0)
            {
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold mb-0">Tìm thấy <span class="text-danger">@Model.Count</span> đơn hàng phù hợp</h5>
                    <a href="/Tra-Cuu-Don-Hang" class="btn btn-sm btn-outline-secondary rounded-pill">Xóa tìm kiếm</a>
                </div>

                <div class="d-flex flex-column gap-4">
                    @foreach (var order in Model)
                    {
                        var statusClass = order.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Shipping" => "bg-primary text-white",
                            "Done" => "bg-success text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };

                        var statusText = order.Status switch
                        {
                            "Pending" => "Chờ xác nhận",
                            "Shipping" => "Đang vận chuyển",
                            "Done" => "Đã hoàn thành",
                            "Cancelled" => "Đã hủy đơn",
                            _ => order.Status
                        };

                        int currentStep = order.Status switch
                        {
                            "Pending" => 1,
                            "Shipping" => 3,
                            "Done" => 4,
                            "Cancelled" => 0,
                            _ => 1
                        };

                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <!-- Card Header -->
                            <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h5 class="fw-black mb-0 text-danger">#DH-@order.Id.ToString("D5")</h5>
                                        <span class="badge @statusClass rounded-pill px-3 py-1">@statusText</span>
                                    </div>
                                    <small class="text-muted">Ngày đặt hàng: @order.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                                </div>
                                <div class="text-md-end">
                                    <div class="text-muted small">Tổng tiền thanh toán</div>
                                    <div class="fs-4 fw-black text-danger">@order.Total.ToString("N0")đ</div>
                                </div>
                            </div>

                            <div class="card-body p-3 p-md-4">
                                <!-- TIMELINE STEPPER (If not cancelled) -->
                                @if (order.Status != "Cancelled")
                                {
                                    <div class="order-timeline-wrapper mb-4 py-3">
                                        <div class="order-timeline">
                                            <div class="step-item @(currentStep >= 1 ? "active" : "")">
                                                <div class="step-circle"><i class="bi bi-file-earmark-text"></i></div>
                                                <div class="step-title">Tiếp nhận</div>
                                                <div class="step-sub">Đơn hàng mới</div>
                                            </div>
                                            <div class="step-line @(currentStep >= 2 ? "active" : "")"></div>
                                            <div class="step-item @(currentStep >= 2 ? "active" : "")">
                                                <div class="step-circle"><i class="bi bi-box-seam"></i></div>
                                                <div class="step-title">Đóng gói</div>
                                                <div class="step-sub">Chuẩn bị kiện hàng</div>
                                            </div>
                                            <div class="step-line @(currentStep >= 3 ? "active" : "")"></div>
                                            <div class="step-item @(currentStep >= 3 ? "active" : "")">
                                                <div class="step-circle"><i class="bi bi-truck"></i></div>
                                                <div class="step-title">Đang giao</div>
                                                <div class="step-sub">Shipper chuyển phát</div>
                                            </div>
                                            <div class="step-line @(currentStep >= 4 ? "active" : "")"></div>
                                            <div class="step-item @(currentStep >= 4 ? "active" : "")">
                                                <div class="step-circle"><i class="bi bi-check-circle-fill"></i></div>
                                                <div class="step-title">Hoàn tất</div>
                                                <div class="step-sub">Nhận hàng thành công</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-4">
                                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                        <div>Đơn hàng này đã bị hủy. Nếu có bất kỳ thắc mắc nào, vui lòng liên hệ hotline <strong>0900 000 000</strong> để được giải quyết nhanh nhất.</div>
                                    </div>
                                }

                                <!-- CUSTOMER INFO -->
                                <div class="row g-3 mb-4 p-3 bg-light rounded-3">
                                    <div class="col-sm-6 col-md-4">
                                        <div class="text-muted small">Người nhận</div>
                                        <div class="fw-bold">@order.FullName</div>
                                    </div>
                                    <div class="col-sm-6 col-md-4">
                                        <div class="text-muted small">Số điện thoại</div>
                                        <div class="fw-bold">@order.Phone</div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="text-muted small">Địa chỉ nhận hàng</div>
                                        <div class="fw-bold text-truncate" title="@order.Address">@order.Address</div>
                                    </div>
                                </div>

                                <!-- ITEMS LIST -->
                                <h6 class="fw-bold mb-3">Chi tiết sản phẩm (@order.Items.Count món):</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" style="min-width: 250px;">Tên sản phẩm</th>
                                                <th scope="col" class="text-center">Quy cách</th>
                                                <th scope="col" class="text-center">Số lượng</th>
                                                <th scope="col" class="text-end">Đơn giá</th>
                                                <th scope="col" class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.Items)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@item.ProductName</div>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (!string.IsNullOrWhiteSpace(item.Size) || !string.IsNullOrWhiteSpace(item.Color))
                                                        {
                                                            <span class="badge bg-light text-secondary border">
                                                                @(string.IsNullOrWhiteSpace(item.Size) ? "" : item.Size) 
                                                                @(string.IsNullOrWhiteSpace(item.Color) ? "" : $" - {item.Color}")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center fw-bold">@item.Quantity</td>
                                                    <td class="text-end text-muted">@item.UnitPrice.ToString("N0")đ</td>
                                                    <td class="text-end fw-bold text-danger">@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="card-footer bg-white border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="text-muted small">Bạn cần trợ giúp về đơn hàng này? Gọi ngay <a href="tel:0900000000" class="text-danger fw-bold">0900 000 000</a></span>
                                <a href="https://zalo.me" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-chat-dots-fill me-1"></i>Hỗ trợ qua Zalo
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                    <div class="display-3 mb-3 text-muted"><i class="bi bi-search"></i></div>
                    <h4 class="fw-bold mb-2">Không tìm thấy đơn hàng nào!</h4>
                    <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
                        Không có dữ liệu đơn hàng khớp với từ khóa "<strong>@keyword</strong>". 
                        Vui lòng kiểm tra lại chính xác số điện thoại đặt hàng hoặc mã đơn hàng.
                    </p>
                    <div>
                        <a href="/Tra-Cuu-Don-Hang" class="btn btn-outline-danger rounded-pill px-4">Thử lại</a>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- INFORMATIONAL CARDS WHEN NOT SEARCHED -->
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                        <div class="fs-1 mb-3 text-danger"><i class="bi bi-lightning-charge-fill"></i></div>
                        <h5 class="fw-bold">Cập nhật theo thời gian thực</h5>
                        <p class="text-muted small mb-0">Hệ thống đồng bộ trực tiếp với bộ phận kho và đơn vị vận chuyển (GHTK, ViettelPost), giúp bạn nắm rõ từng chặng đường của gói hàng.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                        <div class="fs-1 mb-3 text-primary"><i class="bi bi-shield-check"></i></div>
                        <h5 class="fw-bold">Đồng kiểm khi nhận hàng</h5>
                        <p class="text-muted small mb-0">Tiêu Đao Badminton hỗ trợ khách hàng kiểm tra ngoại quan vợt, mã vạch chống hàng giả và quà tặng đi kèm trước khi thanh toán.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                        <div class="fs-1 mb-3 text-success"><i class="bi bi-chat-dots-fill"></i></div>
                        <h5 class="fw-bold">Đổi trả siêu tốc 7 ngày</h5>
                        <p class="text-muted small mb-0">Nếu phát sinh sai sót về mẫu mã, size giày hoặc lỗi kỹ thuật từ nhà sản xuất, chúng tôi hỗ trợ đổi mới miễn phí tận nhà.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
/* ORDER TRACKING TIMELINE STYLING */
.order-timeline-wrapper {
    background: #f8fafc;
    border-radius: 16px;
    padding: 20px 15px;
}
.order-timeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    max-width: 700px;
    margin: 0 auto;
}
.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 2;
    min-width: 80px;
}
.step-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 8px;
    transition: all 0.3s ease;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.step-item.active .step-circle {
    background: #dc2626;
    color: #fff;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
    transform: scale(1.08);
}
.step-title {
    font-weight: 700;
    font-size: 13px;
    color: #475569;
}
.step-item.active .step-title {
    color: #dc2626;
}
.step-sub {
    font-size: 11px;
    color: #94a3b8;
}
.step-line {
    flex: 1;
    height: 4px;
    background: #e2e8f0;
    margin: 0 6px;
    margin-bottom: 24px;
    border-radius: 2px;
    transition: all 0.3s ease;
}
.step-line.active {
    background: #dc2626;
}

@@media (max-width: 576px) {
    .step-circle {
        width: 36px;
        height: 36px;
        font-size: 16px;
    }
    .step-title {
        font-size: 11px;
    }
    .step-sub {
        display: none;
    }
    .step-line {
        margin-bottom: 18px;
    }
}
</style>

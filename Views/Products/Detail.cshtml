@section Scripts {
    <script>
        // Chuyển ảnh chính khi click thumbnail
        function switchImage(src, element) {
            const mainImg = document.getElementById('mainProductImg');
            if (mainImg) {
                mainImg.src = src;
            }
            document.querySelectorAll('.thumb-item-btn').forEach(btn => btn.classList.remove('active'));
            if (element) {
                element.classList.add('active');
            }
        }

        function adjustQty(delta) {
            const input = document.getElementById('buyQty');
            if (input) {
                let val = parseInt(input.value) || 1;
                val += delta;
                if (val < 1) val = 1;
                if (val > 99) val = 99;
                input.value = val;
            }
        }

        // MA TRẬN BIẾN THỂ (TÁCH RIÊNG MÀU SẮC & KÍCH CỠ) - SỬ DỤNG JSON RAW ĐỂ TRÁNH RAZOR HTML ENCODE CÁC KÝ TỰ TIẾNG VIỆT
        const variantMatrix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(variants.Select(v => new {
            id = v.Id,
            size = (v.Size ?? "").Trim(),
            color = (v.Color ?? "").Trim(),
            imageUrl = (v.ImageUrl ?? "").Trim(),
            stock = v.Stock,
            sku = (v.Sku ?? "").Trim()
        })));

        // BẢN ĐỒ ẢNH PREVIEW THEO TỪNG MÀU SẮC (QUẦN ÁO, GIÀY, VỢT)
        const colorPreviewList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(availableColors.Select(c => new {
            color = c,
            imageUrl = colorImageMap.ContainsKey(c) ? colorImageMap[c] : (Model.MainImageUrl ?? "/img/demo/placeholder.jpg"),
            hex = GetColorHex(c)
        })));

        const hasColorSelection = @(hasColors ? "true" : "false");
        const hasSizeSelection = @(hasSizes ? "true" : "false");

        // KHÔNG CHỌN MẶC ĐỊNH MÀU VÀ SIZE
        let selectedColor = "";
        let selectedSize = "";

        // Chuẩn hóa chuỗi so sánh (loại bỏ khoảng trắng, đưa về chữ thường và Unicode NFC)
        function normStr(str) {
            return (str || '').toString().trim().normalize('NFC').toLowerCase();
        }

        // Cập nhật ảnh preview sản phẩm theo màu sắc được chọn
        function updateProductPreviewForColor(colorName) {
            const mainImg = document.getElementById('mainProductImg');
            const badge = document.getElementById('activeColorPreviewBadge');
            const badgeSwatch = document.getElementById('previewBadgeSwatch');
            const badgeText = document.getElementById('previewBadgeColorName');

            const cNorm = normStr(colorName);
            const matchedColorInfo = colorPreviewList.find(item => normStr(item.color) === cNorm);

            if (mainImg && matchedColorInfo && matchedColorInfo.imageUrl) {
                if (mainImg.getAttribute('src') !== matchedColorInfo.imageUrl) {
                    mainImg.classList.add('switching-color');
                    setTimeout(() => {
                        mainImg.src = matchedColorInfo.imageUrl;
                        mainImg.classList.remove('switching-color');
                    }, 120);
                }
            }

            if (badge && matchedColorInfo) {
                badge.style.display = 'inline-flex';
                if (badgeSwatch) badgeSwatch.style.background = matchedColorInfo.hex || '#3b82f6';
                if (badgeText) badgeText.textContent = colorName;
            }

            // Đồng bộ trạng thái active trên thanh Thumbnail màu bên dưới ảnh chính
            document.querySelectorAll('.color-thumb-card').forEach(card => {
                const thumbColor = card.getAttribute('data-thumb-color');
                if (thumbColor && normStr(thumbColor) === cNorm) {
                    card.classList.add('active');
                } else {
                    card.classList.remove('active');
                }
            });
        }

        // Khi người dùng bấm vào Thumbnail màu sắc dưới ảnh chính -> tự động chọn cả nút Màu bên phải
        function selectColorFromThumb(colorName) {
            const cNorm = normStr(colorName);
            document.querySelectorAll('.color-chip-radio').forEach(radio => {
                if (normStr(radio.value) === cNorm) {
                    radio.checked = true;
                }
            });
            onColorChanged(colorName);
        }

        // Khôi phục ảnh mặc định khi bấm vào thumbnail "Ảnh gốc"
        function resetToDefaultProductImage(thumbEl) {
            const mainImg = document.getElementById('mainProductImg');
            const badge = document.getElementById('activeColorPreviewBadge');
            if (mainImg) {
                const defaultSrc = mainImg.getAttribute('data-default-src') || mainImg.src;
                mainImg.classList.add('switching-color');
                setTimeout(() => {
                    mainImg.src = defaultSrc;
                    mainImg.classList.remove('switching-color');
                }, 120);
            }
            if (badge) badge.style.display = 'none';
            document.querySelectorAll('.color-thumb-card').forEach(card => card.classList.remove('active'));
            if (thumbEl) thumbEl.classList.add('active');
        }

        function findMatchingVariant(color, size) {
            const cNorm = normStr(color);
            const sNorm = normStr(size);
            return variantMatrix.find(v => {
                const vColor = normStr(v.color);
                const vSize = normStr(v.size);
                const matchColor = !cNorm || vColor === cNorm;
                const matchSize = !sNorm || vSize === sNorm;
                return matchColor && matchSize;
            });
        }

        function updateStockFeedback() {
            const activeInput = document.getElementById('activeVariantId');
            const feedbackText = document.getElementById('variantFeedbackText');
            const feedbackBanner = document.getElementById('variantFeedbackBanner');
            const feedbackIcon = document.getElementById('variantFeedbackIcon');

            // 1. Trường hợp cần chọn màu nhưng chưa chọn màu
            if (hasColorSelection && !selectedColor) {
                if (activeInput) activeInput.value = "";
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#f8fafc';
                    feedbackBanner.style.borderColor = '#e2e8f0';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-lightbulb-fill text-warning"></i>';
                    feedbackText.className = 'fw-semibold text-muted';
                    feedbackText.innerHTML = hasSizeSelection
                        ? 'Vui lòng <strong>chọn Màu sắc</strong> và <strong>Kích cỡ</strong> phù hợp với bạn.'
                        : 'Vui lòng <strong>chọn Màu sắc</strong> bạn yêu thích.';
                }
                return;
            }

            // 2. Đã chọn màu (hoặc ko có màu) nhưng chưa chọn size
            if (hasSizeSelection && !selectedSize) {
                if (activeInput) activeInput.value = "";
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#eff6ff';
                    feedbackBanner.style.borderColor = '#bfdbfe';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-arrow-right-circle-fill text-primary"></i>';
                    feedbackText.className = 'fw-bold text-primary';
                    feedbackText.innerHTML = hasColorSelection
                        ? `Đã chọn màu: <strong>${selectedColor}</strong>. Vui lòng chọn tiếp <strong>Kích cỡ (Size)</strong> bên dưới.`
                        : 'Vui lòng <strong>chọn Kích cỡ (Size)</strong> phù hợp với bạn.';
                }
                return;
            }

            // 3. Đã chọn đủ cả màu và size (hoặc chỉ có 1 trong 2 và đã chọn xong)
            const v = findMatchingVariant(selectedColor, selectedSize);

            if (!v) {
                if (activeInput) activeInput.value = "";
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#fef2f2';
                    feedbackBanner.style.borderColor = '#fecaca';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger"></i>';
                    feedbackText.className = 'fw-bold text-danger';
                    feedbackText.innerHTML = `Phân loại này hiện không khả dụng. Vui lòng chọn phối màu hoặc kích cỡ khác!`;
                }
                return;
            }

            if (v.stock > 0) {
                if (activeInput) activeInput.value = v.id;
            } else {
                if (activeInput) activeInput.value = "";
            }

            let desc = "";
            if (selectedColor && selectedSize) {
                desc = `Màu <strong>${selectedColor}</strong> • Size <strong>${selectedSize}</strong>`;
            } else if (selectedColor) {
                desc = `Màu <strong>${selectedColor}</strong>`;
            } else if (selectedSize) {
                desc = `Size <strong>${selectedSize}</strong>`;
            } else {
                desc = `Phiên bản tiêu chuẩn`;
            }

            if (feedbackBanner && feedbackText) {
                if (v.stock > 0) {
                    feedbackBanner.style.background = '#f0fdf4';
                    feedbackBanner.style.borderColor = '#bbf7d0';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
                    feedbackText.className = 'fw-bold text-success';
                    feedbackText.innerHTML = `Đã chọn: ${desc} — Kho hàng còn sẵn <strong>${v.stock}</strong> chiếc (Mã SKU kho: <span class="font-monospace text-dark fw-bold">${v.sku || 'SP-' + v.id}</span>)`;
                } else {
                    feedbackBanner.style.background = '#fef2f2';
                    feedbackBanner.style.borderColor = '#fecaca';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
                    feedbackText.className = 'fw-bold text-danger';
                    feedbackText.innerHTML = `Đã chọn: ${desc} — <strong>Tạm hết hàng trong kho</strong>, vui lòng chọn màu hoặc size khác!`;
                }
            }
        }

        // Khi người dùng chọn Màu sắc: CẬP NHẬT ẢNH PREVIEW THEO MÀU & HIỂN THỊ CÁC SIZE CÓ TRONG KHO
        function onColorChanged(colorName) {
            selectedColor = (colorName || '').trim();
            const colorDisplay = document.getElementById('selectedColorDisplay');
            if (colorDisplay) {
                colorDisplay.className = 'badge bg-primary px-2 py-1 fw-bold text-white';
                colorDisplay.textContent = selectedColor;
            }

            // Đổi ảnh preview tương ứng với màu sắc đã chọn
            updateProductPreviewForColor(selectedColor);

            // Cập nhật nhãn size: từ "Chờ chọn màu" sang "Chưa chọn size" khi vừa chọn màu
            const sizeDisplay = document.getElementById('selectedSizeDisplay');
            if (sizeDisplay && !selectedSize) {
                sizeDisplay.className = 'badge bg-light text-muted border px-2 py-1';
                sizeDisplay.textContent = 'Chưa chọn size';
            }

            // Ẩn thông báo chờ và hiển thị lưới size
            const promptBox = document.getElementById('sizePromptNoColor');
            if (promptBox) promptBox.style.display = 'none';

            const sizeGrid = document.getElementById('sizeGridContainer');
            if (sizeGrid) {
                sizeGrid.style.display = 'grid';
            }

            // Lọc và cập nhật chính xác các size từ kho hàng cho màu được chọn
            let currentSelectedSizeHasStock = false;

            document.querySelectorAll('.size-chip-radio').forEach(sizeRadio => {
                const sVal = sizeRadio.value;
                const v = findMatchingVariant(selectedColor, sVal);
                const tile = document.querySelector(`label[for="${sizeRadio.id}"]`);
                const stockSpan = tile ? tile.querySelector('.size-stock') : null;

                // Nếu trong kho hàng không có phân loại này cho màu đang chọn -> ẩn đi
                if (!v) {
                    if (tile) tile.style.display = 'none';
                    return;
                }

                // Nếu có trong kho -> hiển thị tile
                if (tile) tile.style.display = 'flex';

                const stock = v.stock;
                if (stockSpan) {
                    stockSpan.innerHTML = stock > 0 ? `<span class="text-success fw-bold">Còn ${stock}</span>` : `<span class="text-danger">Hết hàng</span>`;
                }

                if (tile) {
                    if (stock > 0) {
                        tile.classList.remove('out-of-stock');
                        if (normStr(sVal) === normStr(selectedSize)) {
                            currentSelectedSizeHasStock = true;
                        }
                    } else {
                        tile.classList.add('out-of-stock');
                    }
                }
            });

            // Nếu trước đó đã chọn 1 size nhưng sang màu mới size này hết hàng hoặc không có: reset size đã chọn
            if (selectedSize && !currentSelectedSizeHasStock) {
                selectedSize = "";
                document.querySelectorAll('.size-chip-radio').forEach(r => r.checked = false);
                if (sizeDisplay) {
                    sizeDisplay.className = 'badge bg-light text-muted border px-2 py-1';
                    sizeDisplay.textContent = 'Chưa chọn size';
                }
            }

            updateStockFeedback();
        }

        // Khi người dùng chọn Size
        function onSizeChanged(sizeName) {
            selectedSize = (sizeName || '').trim();
            const sizeDisplay = document.getElementById('selectedSizeDisplay');
            if (sizeDisplay) {
                sizeDisplay.className = 'badge bg-dark text-white px-2 py-1 fw-bold';
                sizeDisplay.textContent = selectedSize;
            }

            updateStockFeedback();
        }

        // Kiểm tra hợp lệ trước khi submit form mua hàng
        function validateVariantSelection() {
            const selectorCard = document.getElementById('variantSelectorCard');
            const feedbackBanner = document.getElementById('variantFeedbackBanner');
            const feedbackText = document.getElementById('variantFeedbackText');
            const feedbackIcon = document.getElementById('variantFeedbackIcon');

            if (hasColorSelection && !selectedColor) {
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#fef2f2';
                    feedbackBanner.style.borderColor = '#fecaca';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger"></i>';
                    feedbackText.className = 'fw-bold text-danger';
                    feedbackText.innerHTML = 'Vui lòng chọn <strong>Màu sắc</strong> sản phẩm trước khi mua hàng!';
                }
                if (selectorCard) {
                    selectorCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    selectorCard.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.4)';
                    setTimeout(() => selectorCard.style.boxShadow = '', 2200);
                }
                return false;
            }

            if (hasSizeSelection && !selectedSize) {
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#fef2f2';
                    feedbackBanner.style.borderColor = '#fecaca';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger"></i>';
                    feedbackText.className = 'fw-bold text-danger';
                    feedbackText.innerHTML = 'Vui lòng chọn <strong>Kích cỡ (Size)</strong> sản phẩm trước khi mua hàng!';
                }
                if (selectorCard) {
                    selectorCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    selectorCard.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.4)';
                    setTimeout(() => selectorCard.style.boxShadow = '', 2200);
                }
                return false;
            }

            const activeInput = document.getElementById('activeVariantId');
            if ((hasColorSelection || hasSizeSelection) && (!activeInput || !activeInput.value)) {
                if (feedbackBanner && feedbackText) {
                    feedbackBanner.style.background = '#fef2f2';
                    feedbackBanner.style.borderColor = '#fecaca';
                    if (feedbackIcon) feedbackIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
                    feedbackText.className = 'fw-bold text-danger';
                    feedbackText.innerHTML = 'Phân loại bạn chọn hiện <strong>đang hết hàng</strong>. Vui lòng chọn màu hoặc size khác!';
                }
                return false;
            }

            return true;
        }

        // Bắt sự kiện nộp form Thêm vào giỏ
        const addCartForm = document.getElementById('addToCartForm');
        if (addCartForm) {
            addCartForm.addEventListener('submit', function (e) {
                if (!validateVariantSelection()) {
                    e.preventDefault();
                    return false;
                }
            });
        }

        // Nút Mua ngay: Submit form và chuyển hướng tới giỏ/checkout
        function buyNowSubmit() {
            if (!validateVariantSelection()) return;
            const form = document.getElementById('addToCartForm');
            const returnInput = form.querySelector('input[name="returnUrl"]');
            if (returnInput) {
                returnInput.value = '/Checkout';
            }
            form.submit();
        }

        // Lắng nghe thay đổi mức căng cước để cập nhật lời khuyên
        document.querySelectorAll('.tension-chip-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                const descText = document.getElementById('tensionDescText');
                if (descText && this.dataset.desc) {
                    descText.textContent = this.dataset.desc;
                }
            });
        });

        // INTERACTIVE STAR PICKER TRONG MODAL ĐÁNH GIÁ
        const starLabels = {
            1: "Chưa hài lòng (1 sao)",
            2: "Tạm được (2 sao)",
            3: "Bình thường (3 sao)",
            4: "Rất tốt (4 sao)",
            5: "Tuyệt vời (5 sao)"
        };

        const starPickerItems = document.querySelectorAll('.star-picker-item');
        const starRatingInput = document.getElementById('reviewRatingInput');
        const starPickerLabel = document.getElementById('starPickerLabel');

        starPickerItems.forEach(item => {
            item.addEventListener('click', function() {
                const val = parseInt(this.getAttribute('data-val'));
                if (starRatingInput) starRatingInput.value = val;
                if (starPickerLabel) starPickerLabel.textContent = starLabels[val] || `${val} sao`;

                starPickerItems.forEach(star => {
                    const starVal = parseInt(star.getAttribute('data-val'));
                    if (starVal <= val) {
                        star.classList.add('active');
                    } else {
                        star.classList.remove('active');
                    }
                });
            });
        });

        // LỌC ĐÁNH GIÁ CLIENT-SIDE THEO SỐ SAO
        document.querySelectorAll('.review-filter-chip').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.review-filter-chip').forEach(b => {
                    b.classList.remove('btn-dark', 'active');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.add('btn-dark', 'active');
                this.classList.remove('btn-outline-secondary');

                const ratingFilter = this.getAttribute('data-rating');
                const reviewCards = document.querySelectorAll('.review-card-item');

                reviewCards.forEach(card => {
                    const cardRating = card.getAttribute('data-rating');
                    if (ratingFilter === 'all' || cardRating === ratingFilter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // VOTE HỮU ÍCH AJAX
        function voteHelpful(reviewId, btnElement) {
            if (btnElement.classList.contains('voted')) return;

            fetch('/Products/VoteHelpful?reviewId=' + reviewId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const counter = btnElement.querySelector('.helpful-counter');
                    if (counter) {
                        counter.textContent = data.helpfulCount;
                    }
                    btnElement.classList.add('voted', 'btn-success', 'text-white');
                    btnElement.classList.remove('btn-light', 'text-muted');
                }
            })
            .catch(err => console.error(err));
        }

        // Đồng bộ dữ liệu kho hàng khi trang tải (Dành cho sản phẩm chỉ có Size mà không có Màu)
        document.addEventListener('DOMContentLoaded', function () {
            if (!hasColorSelection && hasSizeSelection) {
                document.querySelectorAll('.size-chip-radio').forEach(sizeRadio => {
                    const sVal = sizeRadio.value;
                    const v = findMatchingVariant("", sVal);
                    const tile = document.querySelector(`label[for="${sizeRadio.id}"]`);
                    const stockSpan = tile ? tile.querySelector('.size-stock') : null;

                    if (!v) {
                        if (tile) tile.style.display = 'none';
                        return;
                    }
                    if (tile) tile.style.display = 'flex';

                    const stock = v.stock;
                    if (stockSpan) {
                        stockSpan.innerHTML = stock > 0 ? `<span class="text-success fw-bold">Còn ${stock}</span>` : `<span class="text-danger">Hết hàng</span>`;
                    }
                    if (tile) {
                        if (stock > 0) {
                            tile.classList.remove('out-of-stock');
                        } else {
                            tile.classList.add('out-of-stock');
                        }
                    }
                });
            }
        });
    </script>
}

@model List<tieudaobadminton.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi - Tiêu Đao Badminton";
}

<div class="py-5 bg-light" style="min-height: 80vh;">
    <div class="container" style="max-width: 1000px;">
        <!-- BREADCRUMB & HEADER -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn hàng của tôi</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h1 class="fw-black h3 mb-1">📦 Lịch Sử Đơn Hàng Của Tôi</h1>
                <p class="text-muted mb-0">Quản lý và theo dõi tiến độ các đơn hàng bạn đã mua tại Tiêu Đao Badminton.</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold">
                🛍️ Tiếp tục mua sắm
            </a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-white">
                <div class="display-3 mb-3">🛒</div>
                <h4 class="fw-bold mb-2">Bạn chưa có đơn hàng nào</h4>
                <p class="text-muted mb-4" style="max-width: 450px; margin: 0 auto;">
                    Khám phá ngay bộ sưu tập vợt cầu lông, giày thi đấu và phụ kiện chính hãng mới nhất tại Tiêu Đao Badminton!
                </p>
                <div>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                        Khám phá sản phẩm
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var order in Model)
                {
                    var statusClass = order.Status switch
                    {
                        "Pending" => "bg-warning-subtle text-warning border border-warning",
                        "Shipping" => "bg-primary-subtle text-primary border border-primary",
                        "Done" => "bg-success-subtle text-success border border-success",
                        "Cancelled" => "bg-danger-subtle text-danger border border-danger",
                        _ => "bg-secondary-subtle text-secondary"
                    };

                    var statusText = order.Status switch
                    {
                        "Pending" => "⏳ Chờ xác nhận",
                        "Shipping" => "🚚 Đang vận chuyển",
                        "Done" => "✅ Giao hàng thành công",
                        "Cancelled" => "❌ Đã hủy",
                        _ => order.Status
                    };

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <div class="fw-black fs-5 text-dark">Đơn hàng #DH-@order.Id.ToString("D5")</div>
                                    <small class="text-muted">Đặt lúc @order.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @statusClass rounded-pill px-3 py-2 fw-bold">@statusText</span>
                                <a href="/Tra-Cuu-Don-Hang?keyword=@order.Id" class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3">
                                    Theo dõi vận chuyển ➔
                                </a>
                            </div>
                        </div>

                        <div class="card-body p-3 p-md-4">
                            <!-- ITEMS PREVIEW -->
                            <div class="d-flex flex-column gap-3 mb-3">
                                @foreach (var item in order.Items)
                                {
                                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                        <div>
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                            <div class="small text-muted">
                                                @if (!string.IsNullOrWhiteSpace(item.Size) || !string.IsNullOrWhiteSpace(item.Color))
                                                {
                                                    <span>Phân loại: @item.Size @(string.IsNullOrWhiteSpace(item.Color) ? "" : $"| {item.Color}") • </span>
                                                }
                                                <span>Số lượng: x@(item.Quantity)</span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold text-dark">@((item.UnitPrice * item.Quantity).ToString("N0"))đ</div>
                                            <small class="text-muted">@item.UnitPrice.ToString("N0")đ/món</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- ORDER SUMMARY -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center pt-2">
                                <div class="text-muted small">
                                    <span>📍 Giao tới: <strong>@order.FullName</strong> - @order.Phone, @order.Address</span>
                                </div>
                                <div class="text-end mt-2 mt-md-0">
                                    <span class="text-muted me-2">Tổng giá trị đơn hàng:</span>
                                    <span class="fs-4 fw-black text-danger">@order.Total.ToString("N0")đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

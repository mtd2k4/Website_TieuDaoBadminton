@model tieudaobadminton.Models.Order
@{
    ViewData["Title"] = $"Đặt hàng thành công #{Model.Id:D5}";
    var method = ViewBag.PaymentMethod as string ?? "COD";
    var orderCode = $"DH{Model.Id:D5}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- SUCCESS CARD -->
            <div class="cart-surface p-4 p-md-5 text-center shadow-sm">
                <!-- Checkmark Icon -->
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3"
                     style="width: 80px; height: 80px; font-size: 2.5rem;">
                    <i class="bi bi-check-lg"></i>
                </div>

                <h2 class="fw-bold text-dark mb-2">Đặt hàng thành công!</h2>
                <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
                    Cảm ơn quý khách đã tin tưởng mua sắm tại <strong>Tiêu Đao Badminton</strong>. Đơn hàng của bạn đã được tiếp nhận và nhân viên sẽ liên hệ xác nhận trong thời gian sớm nhất.
                </p>

                <div class="badge bg-light text-dark border px-3 py-2 fs-6 mb-3">
                    Mã đơn hàng: <strong class="text-primary">#@orderCode</strong>
                </div>

                @{
                    var customerEmail = TempData["CustomerEmail"] as string;
                    var emailSent = TempData["EmailSent"] as bool? ?? false;
                }
                <div class="alert @(emailSent ? "alert-success" : "alert-info") rounded-4 py-2 px-3 small mb-4 d-flex align-items-center justify-content-center gap-2 mx-auto" style="max-width: 580px;">
                    <i class="bi bi-envelope-check-fill fs-5"></i>
                    <span>
                        @if (emailSent && !string.IsNullOrWhiteSpace(customerEmail))
                        {
                            <text>Đã gửi email xác nhận đặt hàng qua SMTP tới <strong>@customerEmail</strong> và thông báo đơn mới về <strong>Admin</strong>!</text>
                        }
                        else if (!string.IsNullOrWhiteSpace(customerEmail))
                        {
                            <text>Thông tin đơn hàng đã ghi nhận cho email <strong>@customerEmail</strong> và đã gửi thông báo đơn hàng mới lên bảng điều khiển <strong>Admin</strong>!</text>
                        }
                        else
                        {
                            <text>Đã gửi thông báo đơn hàng mới <strong>#@orderCode</strong> trực tiếp về hệ thống <strong>Admin</strong>!</text>
                        }
                    </span>
                </div>

                <!-- VIETQR SECTION (NẾU CHỌN CHUYỂN KHOẢN) -->
                @if (method == "BankTransfer")
                {
                    <div class="p-4 rounded-4 mb-4 text-start border border-primary border-opacity-25" style="background: #f0f9ff;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="fs-4 text-primary"><i class="bi bi-qr-code-scan"></i></span>
                            <h5 class="fw-bold text-primary mb-0">Quét mã VietQR thanh toán nhanh</h5>
                        </div>

                        <div class="row align-items-center g-4">
                            <div class="col-md-5 text-center">
                                <img src="https://img.vietqr.io/image/MB-0900000000-compact2.png?amount=@((long)Model.Total)&addInfo=@orderCode&accountName=TIEU%20DAO%20BADMINTON"
                                     class="img-fluid rounded-3 shadow-sm border bg-white p-2"
                                     alt="Mã VietQR Đơn hàng #@orderCode"
                                     style="max-width: 220px;" />
                                <div class="text-muted small mt-2">Mở App Ngân hàng bất kỳ để quét</div>
                            </div>

                            <div class="col-md-7">
                                <div class="small text-muted mb-1">Ngân hàng thụ hưởng:</div>
                                <div class="fw-bold text-dark mb-2">MB Bank (Ngân hàng Quân Đội)</div>

                                <div class="small text-muted mb-1">Số tài khoản:</div>
                                <div class="fw-bold text-primary fs-5 mb-2">0900 000 000</div>

                                <div class="small text-muted mb-1">Chủ tài khoản:</div>
                                <div class="fw-bold text-dark mb-2">TIEU DAO BADMINTON</div>

                                <div class="small text-muted mb-1">Số tiền thanh toán:</div>
                                <div class="fw-bold text-danger fs-5 mb-2">@Model.Total.ToString("n0") đ</div>

                                <div class="small text-muted mb-1">Nội dung chuyển khoản (bắt buộc):</div>
                                <span class="badge bg-dark text-white p-2 font-monospace fs-6">@orderCode</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- ORDER DETAILS ACCORDION / SUMMARY -->
                <div class="card p-3 text-start border rounded-4 mb-4 bg-light">
                    <h6 class="fw-bold text-dark mb-3">Thông tin giao hàng:</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <span class="text-muted">Người nhận:</span> <strong>@Model.FullName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Số điện thoại:</span> <strong>@Model.Phone</strong>
                        </div>
                        <div class="col-12">
                            <span class="text-muted">Địa chỉ nhận hàng:</span> <strong>@Model.Address</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Phương thức thanh toán:</span> 
                            <strong>@(method == "BankTransfer" ? "Chuyển khoản VietQR" : "Tiền mặt khi nhận (COD)")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Trạng thái:</span> 
                            <span class="badge bg-warning text-dark fw-bold">Chờ xác nhận</span>
                        </div>
                    </div>
                </div>

                <!-- ITEMS LIST -->
                <div class="text-start mb-4">
                    <h6 class="fw-bold text-dark mb-2">Sản phẩm trong đơn:</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm small align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td class="text-muted">@(item.Size ?? "-") / @(item.Color ?? "-")</td>
                                        <td class="text-center">x@(item.Quantity)</td>
                                        <td class="text-end">@item.UnitPrice.ToString("n0") đ</td>
                                        <td class="text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("n0")) đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">Tổng thanh toán:</th>
                                    <th class="text-end text-danger fs-6 fw-bold">@Model.Total.ToString("n0") đ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                        Về trang chủ
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-bold">
                        Tiếp tục mua sắm <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@model List<tieudaobadminton.Models.NewsPost>
@{
    ViewData["Title"] = "Cẩm Nang Cầu Lông - Kiến Thức & Kỹ Thuật Chuyên Sâu";
    var currentTopic = ViewBag.Topic as string;
    var currentQuery = ViewBag.Query as string;

    var featuredPost = Model.FirstOrDefault();
    var gridPosts = Model.Skip(1).ToList();

    // Helper xác định topic badge theo tiêu đề
    string GetTopicBadge(string title)
    {
        var t = title.ToLower();
        if (t.Contains("vợt")) return "🏸 VỢT CẦU LÔNG";
        if (t.Contains("cước") || t.Contains("căng") || t.Contains("đan")) return "🛠️ CĂNG CƯỚC";
        if (t.Contains("giày") || t.Contains("size")) return "👟 GIÀY & ĐỒ TẬP";
        if (t.Contains("kỹ thuật") || t.Contains("smash") || t.Contains("đập")) return "⚡ KỸ THUẬT";
        return "📰 CẨM NANG";
    }
}

<div class="news-page-wrapper">

    <!-- 1. HERO MAGAZINE HEADER -->
    <div class="news-hero-section">
        <div class="container py-4">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb news-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cẩm nang cầu lông</li>
                </ol>
            </nav>

            <div class="row align-items-center justify-content-between g-4">
                <div class="col-lg-7">
                    <span class="news-hero-pill">📖 TẠP CHÍ & BÍ QUYẾT SÂN CẦU</span>
                    <h1 class="news-hero-heading">Cẩm Nang & Kinh Nghiệm Cầu Lông</h1>
                    <p class="news-hero-sub">
                        Cập nhật các bài viết phân tích vợt chuyên sâu, kỹ thuật đập cầu smash uy lực, bảng đo size chân chuẩn xác và kinh nghiệm đan cước điện tử từ chuyên gia Tiêu Đao.
                    </p>

                    @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                    {
                        <div class="mt-3">
                            <a class="btn btn-sm btn-light rounded-pill px-3 py-2 fw-bold text-dark d-inline-flex align-items-center gap-2 shadow-sm"
                               asp-area="Admin" asp-controller="News" asp-action="Create">
                                <span>✍️</span>
                                <span>Đăng bài viết mới (Admin)</span>
                            </a>
                        </div>
                    }
                </div>

                <div class="col-lg-5">
                    <!-- Search Box -->
                    <form method="get" action="/Cam-Nang" class="news-search-form">
                        <div class="news-search-box">
                            <svg class="news-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" name="q" value="@currentQuery" placeholder="Tìm kiếm cẩm nang, kỹ thuật, vợt..." />
                            <button type="submit" class="news-search-submit">Tìm</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Topic Tabs Navigation -->
            <div class="news-topics-scroll mt-4">
                <div class="news-topics-bar">
                    <a href="/Cam-Nang" class="topic-chip @(string.IsNullOrEmpty(currentTopic) ? "active" : "")">
                        ✨ Tất cả bài viết
                    </a>
                    <a href="/Cam-Nang?topic=vot" class="topic-chip @(currentTopic == "vot" ? "active" : "")">
                        🏸 Tư vấn chọn vợt
                    </a>
                    <a href="/Cam-Nang?topic=ky-thuat" class="topic-chip @(currentTopic == "ky-thuat" ? "active" : "")">
                        ⚡ Kỹ thuật & Smash
                    </a>
                    <a href="/Cam-Nang?topic=giay" class="topic-chip @(currentTopic == "giay" ? "active" : "")">
                        👟 Giày & Chọn size
                    </a>
                    <a href="/Cam-Nang?topic=cang-cuoc" class="topic-chip @(currentTopic == "cang-cuoc" ? "active" : "")">
                        🛠️ Căng cước 4 nút
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">

        <!-- 2. BÀI VIẾT TIÊU ĐIỂM (FEATURED ARTICLE CARD) -->
        @if (featuredPost != null && string.IsNullOrEmpty(currentQuery) && string.IsNullOrEmpty(currentTopic))
        {
            <div class="news-featured-wrapper mb-5">
                <div class="row g-0 align-items-stretch news-featured-card">
                    <div class="col-lg-7">
                        <div class="featured-img-wrap">
                            <img src="@(featuredPost.ThumbnailUrl ?? "/img/banners/banner.jpg")" alt="@featuredPost.Title" class="featured-img" />
                            <span class="featured-badge">🔥 BÀI VIẾT TIÊU ĐIỂM</span>
                        </div>
                    </div>
                    <div class="col-lg-5 d-flex flex-column justify-content-between p-4 p-md-5">
                        <div>
                            <div class="featured-meta-row mb-2">
                                <span class="badge-topic-lead">@GetTopicBadge(featuredPost.Title)</span>
                                <span class="meta-sep">•</span>
                                <span class="meta-date">@featuredPost.PublishedAt.ToString("dd/MM/yyyy")</span>
                                <span class="meta-sep">•</span>
                                <span class="meta-time">⏱️ 5 phút đọc</span>
                            </div>
                            <h2 class="featured-title">
                                <a asp-controller="News" asp-action="Detail" asp-route-id="@featuredPost.Id">
                                    @featuredPost.Title
                                </a>
                            </h2>
                            <p class="featured-desc">
                                @(string.IsNullOrWhiteSpace(featuredPost.Summary) 
                                    ? "Khám phá bài viết cẩm nang chi tiết từ đội ngũ kỹ thuật viên và chuyên gia cầu lông của Tiêu Đao Pro." 
                                    : featuredPost.Summary)
                            </p>
                        </div>
                        <div class="featured-bottom-row pt-3">
                            <div class="author-info d-flex align-items-center gap-2">
                                <div class="author-avatar-badge">🏸</div>
                                <div>
                                    <div class="author-name-text">Tiêu Đao Editorial</div>
                                    <small class="author-role text-muted">Ban Chuyên Môn</small>
                                </div>
                            </div>
                            <a asp-controller="News" asp-action="Detail" asp-route-id="@featuredPost.Id" class="btn btn-dark rounded-pill px-4 py-2 fw-bold">
                                Đọc bài viết →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- 3. HAI CỘT: GRID BÀI VIẾT (8) + SIDEBAR TIỆN ÍCH (4) -->
        <div class="row g-4">
            
            <!-- Cột trái: Danh sách bài viết -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-black text-dark mb-0">
                            @(string.IsNullOrEmpty(currentTopic) && string.IsNullOrEmpty(currentQuery) ? "Các bài cẩm nang mới" : "Kết quả tìm kiếm bài viết")
                        </h4>
                        @if (!string.IsNullOrEmpty(currentQuery))
                        {
                            <small class="text-muted">Tìm thấy theo từ khóa: "<strong>@currentQuery</strong>"</small>
                        }
                    </div>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                        @Model.Count bài viết
                    </span>
                </div>

                @if (!Model.Any())
                {
                    <div class="news-empty-state text-center py-5">
                        <div class="display-3 mb-3">📰</div>
                        <h4 class="fw-bold">Chưa tìm thấy bài viết phù hợp</h4>
                        <p class="text-muted" style="max-width: 420px; margin: 0 auto;">
                            Không có bài cẩm nang nào khớp với tiêu chí bạn đang tìm kiếm. Vui lòng thử lại với từ khóa khác.
                        </p>
                        <a href="/Cam-Nang" class="btn btn-dark rounded-pill px-4 py-2 mt-3 fw-bold">
                            Xem tất cả cẩm nang
                        </a>
                    </div>
                }
                else
                {
                    var displayList = (string.IsNullOrEmpty(currentQuery) && string.IsNullOrEmpty(currentTopic)) ? gridPosts : Model;
                    
                    <div class="row g-4">
                        @foreach (var post in displayList)
                        {
                            <div class="col-md-6">
                                <article class="news-card-pro h-100">
                                    <div class="news-card-thumb-wrap">
                                        <img src="@(post.ThumbnailUrl ?? "/img/banners/banner1.jfif")" alt="@post.Title" class="news-card-thumb" loading="lazy" />
                                        <span class="news-card-topic">@GetTopicBadge(post.Title)</span>
                                    </div>
                                    <div class="news-card-content">
                                        <div class="news-card-meta">
                                            <span>@post.PublishedAt.ToString("dd/MM/yyyy")</span>
                                            <span>•</span>
                                            <span>⏱️ 4 phút</span>
                                        </div>
                                        <h5 class="news-card-title">
                                            <a asp-controller="News" asp-action="Detail" asp-route-id="@post.Id" title="@post.Title">
                                                @post.Title
                                            </a>
                                        </h5>
                                        <p class="news-card-excerpt">
                                            @(string.IsNullOrWhiteSpace(post.Summary)
                                                ? (post.Content?.Length > 115 ? post.Content.Substring(0, 115) + "..." : post.Content)
                                                : post.Summary)
                                        </p>
                                        <div class="news-card-footer mt-auto">
                                            <a asp-controller="News" asp-action="Detail" asp-route-id="@post.Id" class="news-read-link">
                                                <span>Xem chi tiết</span>
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Cột phải: Sidebar Widgets -->
            <div class="col-lg-4">
                <div class="news-sidebar-sticky">

                    <!-- Widget 1: AI Advisor Card -->
                    <div class="news-widget-ai mb-4">
                        <div class="widget-ai-pill">⚡ TRỢ LÝ THÔNG MINH</div>
                        <h5 class="fw-black text-white mb-2">Chưa biết chọn cây vợt nào?</h5>
                        <p class="small text-white-50 mb-3" style="line-height: 1.6;">
                            Công nghệ AI phân tích lối đánh tấn công/thủ, lực cổ tay và ngân sách để đề xuất cây vợt chuẩn xác nhất cho bạn.
                        </p>
                        <a href="/Tu-Van-Chon-Vot" class="btn btn-light rounded-pill w-100 fw-bold text-primary shadow-sm py-2">
                            Thử Trợ Lý AI Ngay →
                        </a>
                    </div>

                    <!-- Widget 2: Trending / Top Guides -->
                    <div class="news-widget-box mb-4">
                        <h6 class="widget-heading">🔥 Cẩm nang đọc nhiều</h6>
                        <div class="widget-trending-list">
                            @for (int idx = 0; idx < Math.Min(Model.Count, 4); idx++)
                            {
                                var item = Model[idx];
                                <a asp-controller="News" asp-action="Detail" asp-route-id="@item.Id" class="trending-item text-decoration-none">
                                    <div class="trending-number">0@(idx + 1)</div>
                                    <div class="trending-info">
                                        <div class="trending-title">@item.Title</div>
                                        <small class="text-muted">@item.PublishedAt.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Widget 3: Quick Services & Tools -->
                    <div class="news-widget-box mb-4">
                        <h6 class="widget-heading">🛠️ Tiện ích & Hướng dẫn</h6>
                        <div class="d-flex flex-column gap-2">
                            <a href="/Dich-Vu-Cang-Cuoc" class="widget-service-row">
                                <span class="service-icon-badge">⚡</span>
                                <div>
                                    <div class="service-row-title">Căng cước máy điện tử 4 nút</div>
                                    <small class="text-muted">Lấy ngay sau 15 phút tại sân</small>
                                </div>
                            </a>
                            <a href="/Huong-Dan-Size" class="widget-service-row">
                                <span class="service-icon-badge">📏</span>
                                <div>
                                    <div class="service-row-title">Bảng đo Size Giày & Cán G5/G6</div>
                                    <small class="text-muted">Đo chính xác theo mm bàn chân</small>
                                </div>
                            </a>
                            <a href="/Tra-Cuu-Don-Hang" class="widget-service-row">
                                <span class="service-icon-badge">📦</span>
                                <div>
                                    <div class="service-row-title">Tra cứu lộ trình đơn hàng</div>
                                    <small class="text-muted">Kiểm tra mã vận đơn hỏa tốc</small>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Widget 4: Newsletter Box -->
                    <div class="news-widget-box">
                        <h6 class="widget-heading">📬 Nhận mẹo chơi cầu hàng tuần</h6>
                        <p class="small text-muted mb-3">
                            Nhận các bài hướng dẫn kỹ thuật mới nhất và ưu đãi đặc quyền từ Tiêu Đao Badminton.
                        </p>
                        <form onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận cẩm nang!'); this.reset();">
                            <div class="newsletter-input-group">
                                <input type="email" placeholder="Nhập địa chỉ email của bạn..." required />
                                <button type="submit" class="btn btn-dark rounded-pill px-3 py-2 fw-bold w-100 mt-2">
                                    Đăng ký nhận cẩm nang
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

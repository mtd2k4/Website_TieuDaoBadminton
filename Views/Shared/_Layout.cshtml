@using tieudaobadminton.Helpers
@using tieudaobadminton.Models
@{
    var currentCart = Context.Session.GetObject<List<CartItem>>("CART") ?? new List<CartItem>();
    var totalCartCount = currentCart.Sum(x => x.Quantity);
    var currentWishlist = Context.Session.GetObject<List<int>>("WISHLIST") ?? new List<int>();
    var totalWishlistCount = currentWishlist.Count;
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeCategory = !string.IsNullOrEmpty(Context.Request.Query["cat"]) ? Context.Request.Query["cat"].ToString() : Context.Request.Query["category"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tiêu Đao Badminton Pro</title>

    <!-- Google Fonts: Be Vietnam Pro (Vietnamese Engineered) + Outfit (Sports Modern Display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Pro Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <!-- 1. TOP ANNOUNCEMENT BAR (COMPACT & SLEEK) -->
    <div class="announcement-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="announcement-badge">ƯU ĐÃI KHAI MÙA</span>
                <span class="announcement-text">Miễn phí căng cước 4 nút & quấn cán cho mọi đơn vợt • Freeship toàn quốc từ 499k</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:0900000000" class="announcement-link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    <span>Hotline: 0900 000 000</span>
                </a>
                <span class="announcement-sep">|</span>
                <a asp-controller="Contact" asp-action="Index" class="announcement-link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <span>Cửa hàng & Sân cầu</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. HIGH-END 2-TIER HEADER -->
    <header class="pro-header">
        <div class="container">
            <!-- TIER 1: BRAND + SEARCH BAR + ACTION GROUP -->
            <div class="pro-header-main-row">
                <!-- Brand Logo (Left) -->
                <a class="pro-brand text-decoration-none" asp-controller="Home" asp-action="Index">
                    <div class="pro-logo-badge">
                        <img src="~/img/tieudao.jpg" alt="Tiêu Đao Badminton" class="pro-logo-img" />
                    </div>
                    <div>
                        <div class="pro-brand-title">TIÊU ĐAO</div>
                        <div class="pro-brand-tag">PRO BADMINTON</div>
                    </div>
                </a>

                <!-- Refined Search Box (Center) -->
                <div class="pro-search-box d-none d-md-block">
                    <form method="get" action="/Danh-Muc">
                        <div class="pro-search-pill">
                            <span class="search-lead-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            </span>
                            <input type="text" name="q" value="@Context.Request.Query["q"]" placeholder="Tìm kiếm vợt Yonex, Victor, giày bám sân..." />
                            <button type="submit" class="pro-search-btn">
                                <span>Tìm kiếm</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Action Group (Right) -->
                <div class="pro-action-group">
                    <!-- Wishlist button (Link to /Yeu-Thich with live Counter) -->
                    <a asp-controller="Wishlist" asp-action="Index" class="pro-icon-btn d-none d-sm-inline-flex" title="Sản phẩm yêu thích">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        <span id="wishlistBadge" class="pro-cart-counter @(totalWishlistCount > 0 ? "" : "d-none")">
                            @(totalWishlistCount > 99 ? "99+" : totalWishlistCount.ToString())
                        </span>
                    </a>

                    <!-- Cart button with Live Counter -->
                    <a asp-controller="Cart" asp-action="Index" class="pro-icon-btn" title="Giỏ hàng">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        @if (totalCartCount > 0)
                        {
                            <span class="pro-cart-counter">@(totalCartCount > 99 ? "99+" : totalCartCount.ToString())</span>
                        }
                    </a>

                    <!-- User Account Dropdown / Auth Buttons -->
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown d-none d-md-block">
                            <button class="btn btn-dark btn-sm rounded-pill px-3 py-2 fw-bold dropdown-toggle d-flex align-items-center gap-2" 
                                    type="button" data-bs-toggle="dropdown">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                <span>@User.Identity!.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-2" style="border-radius: 16px; min-width: 200px;">
                                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 fw-bold text-primary rounded-3" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-bar-chart-line-fill me-1"></i> Bảng Quản trị (Dashboard)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                }
                                <li>
                                    <a class="dropdown-item py-2 fw-bold rounded-3" asp-controller="Account" asp-action="Orders">
                                        <i class="bi bi-box-seam-fill me-1 text-primary"></i> Đơn hàng của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-bold rounded-3" asp-controller="Wishlist" asp-action="Index">
                                        <i class="bi bi-heart-fill me-1 text-danger"></i> Yêu thích (@totalWishlistCount)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2 fw-bold rounded-3">
                                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-none d-md-flex align-items-center gap-2 ms-1">
                            <a class="btn-auth-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn-auth-register" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        </div>
                    }

                    <!-- Mobile Toggler -->
                    <button class="navbar-toggler d-lg-none border-0 p-2 fs-4" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNavPro">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Search Bar (< 768px) -->
            <div class="d-md-none pb-3">
                <form method="get" action="/Danh-Muc">
                    <div class="pro-search-pill">
                        <input type="text" name="q" value="@Context.Request.Query["q"]" placeholder="Tìm vợt, giày, quần áo..." />
                        <button type="submit" class="pro-search-btn">Tìm</button>
                    </div>
                </form>
            </div>

            <!-- TIER 2: STREAMLINED PROFESSIONAL NAVIGATION ROW (DESKTOP) -->
            <div class="pro-header-nav-row d-none d-lg-block">
                <div class="d-flex align-items-center justify-content-between">
                    <ul class="pro-nav-list">
                        <!-- 1. MASTER CATALOG LAUNCHER BUTTON -->
                        <li class="dropdown catalog-mega-dropdown me-1">
                            <a class="nav-catalog-btn dropdown-toggle @(activeController == "Catalog" ? "active" : "")" 
                               href="/Danh-Muc" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                                <span>Danh mục sản phẩm</span>
                                <span class="catalog-caret"><i class="bi bi-chevron-down small"></i></span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-catalog shadow-xl border-0 p-3">
                                <div class="row g-3">
                                    <!-- Cột 1: Vợt cầu lông (Cấp 2) -->
                                    <div class="col-3 catalog-mega-col">
                                        <a class="catalog-mega-title" href="/Danh-Muc?cat=vot">
                                            <i class="bi bi-trophy-fill text-danger me-1"></i> Vợt Cầu Lông
                                        </a>
                                        <ul class="catalog-mega-sublist">
                                            <li><a href="/Danh-Muc?cat=vot&sub=tan-cong">Vợt Tấn Công Smash</a></li>
                                            <li><a href="/Danh-Muc?cat=vot&sub=toan-dien">Công Thủ Toàn Diện</a></li>
                                            <li><a href="/Danh-Muc?cat=vot&sub=phan-tat">Tốc Độ & Phản Tạt</a></li>
                                            <li><a href="/Danh-Muc?cat=vot&sub=tro-luc">Trợ Lực / Dễ Chơi</a></li>
                                            <li><a class="view-all-sub" href="/Danh-Muc?cat=vot">Xem tất cả vợt →</a></li>
                                        </ul>
                                    </div>

                                    <!-- Cột 2: Giày cầu lông (Cấp 2) -->
                                    <div class="col-3 catalog-mega-col">
                                        <a class="catalog-mega-title" href="/Danh-Muc?cat=giay">
                                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Giày Cầu Lông
                                        </a>
                                        <ul class="catalog-mega-sublist">
                                            <li><a href="/Danh-Muc?cat=giay&sub=dem-em">Đệm Êm Giảm Chấn</a></li>
                                            <li><a href="/Danh-Muc?cat=giay&sub=toc-do">Siêu Nhẹ & Tốc Độ</a></li>
                                            <li><a href="/Danh-Muc?cat=giay&sub=wide">Form Chân Bè Wide</a></li>
                                            <li><a href="/Huong-Dan-Size">Bảng đo size chuẩn</a></li>
                                            <li><a class="view-all-sub" href="/Danh-Muc?cat=giay">Xem tất cả giày →</a></li>
                                        </ul>
                                    </div>

                                    <!-- Cột 3: Trang phục thể thao (Cấp 2) -->
                                    <div class="col-3 catalog-mega-col">
                                        <a class="catalog-mega-title" href="/Danh-Muc?cat=quan-ao">
                                            <i class="bi bi-handbag-fill text-primary me-1"></i> Trang Phục & Đồ Tập
                                        </a>
                                        <ul class="catalog-mega-sublist">
                                            <li><a href="/Danh-Muc?cat=quan-ao&sub=ao-nam">Áo Thi Đấu Nam</a></li>
                                            <li><a href="/Danh-Muc?cat=quan-ao&sub=ao-nu">Áo & Váy Cầu Lông Nữ</a></li>
                                            <li><a href="/Danh-Muc?cat=quan-ao&sub=quan-short">Quần Short & Training</a></li>
                                            <li><a class="view-all-sub" href="/Danh-Muc?cat=quan-ao">Xem tất cả trang phục →</a></li>
                                        </ul>
                                    </div>

                                    <!-- Cột 4: Tiện ích & Nổi bật -->
                                    <div class="col-3 catalog-mega-col">
                                        <div class="catalog-dropdown-promo">
                                            <div>
                                                <div class="fw-bold text-dark mb-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Chọn vợt theo lối chơi?</div>
                                                <p class="small text-muted mb-2">Trợ lý AI phân tích lối đánh & lực cổ tay để gợi ý mẫu vợt phù hợp nhất.</p>
                                            </div>
                                            <div>
                                                <a href="/Tu-Van-Chon-Vot" class="btn btn-sm btn-dark rounded-pill w-100 fw-bold mb-2">Khám phá AI →</a>
                                                <a href="/Danh-Muc" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-bold">Xem trọn danh mục</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mega menu bottom banner -->
                                <div class="catalog-mega-bottom">
                                    <div class="small text-muted">
                                        <i class="bi bi-fire text-danger me-1"></i> <strong>100% Chính hãng:</strong> Yonex, Victor, Li-Ning, Mizuno, Kawasaki. Bảo hành đầy đủ, miễn phí căng cước 4 nút!
                                    </div>
                                    <a href="/Danh-Muc" class="fw-bold small text-primary text-decoration-none">
                                        Mở trang danh mục đầy đủ →
                                    </a>
                                </div>
                            </div>
                        </li>

                        <!-- 2. CLEAN HIGH-END TEXT LINKS (COMPACT & BALANCED) -->
                        <li>
                            <a class="pro-nav-link @(activeController == "Home" && activeAction == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                Trang chủ
                            </a>
                        </li>
                        <li>
                            <a class="pro-nav-link @(activeCategory == "vot" ? "active" : "")" 
                               href="/Danh-Muc?cat=vot">
                                Vợt cầu lông
                            </a>
                        </li>
                        <li>
                            <a class="pro-nav-link @(activeCategory == "giay" ? "active" : "")" 
                               href="/Danh-Muc?cat=giay">
                                Giày thi đấu
                            </a>
                        </li>
                        <li>
                            <a class="pro-nav-link @(activeController == "RacketAdvisor" ? "active" : "")" 
                               href="/Tu-Van-Chon-Vot">
                                Tư vấn vợt <span class="nav-pill-ai">AI</span>
                            </a>
                        </li>
                        <li>
                            <a class="pro-nav-link @(activeController == "Course" ? "active" : "")" 
                               href="/Dang-Ky-Khoa-Hoc">
                                Khóa học
                            </a>
                        </li>
                        <li>
                            <a class="pro-nav-link @(activeController == "Ranking" ? "active" : "")" 
                               href="/Bang-Xep-Hang">
                                BXH VĐV
                            </a>
                        </li>

                        <!-- DROPDOWN DỊCH VỤ & CẨM NANG (GOM GỌN CÁC TIỆN ÍCH) -->
                        <li class="dropdown">
                            <a class="pro-nav-link dropdown-toggle @(activeController == "Services" || activeController == "Guide" || activeController == "OrderTracking" || activeController == "News" ? "active" : "")" 
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Dịch vụ &amp; Cẩm nang
                            </a>
                            <ul class="dropdown-menu dropdown-menu-pro shadow-lg border-0 p-2" style="min-width: 300px;">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-3 p-2 rounded-3" href="/Dich-Vu-Cang-Cuoc">
                                        <span class="nav-drop-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-tools"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark small">Căng cước máy điện tử 4 nút</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Bảng giá cước &amp; Lấy ngay sau 15p</small>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-3 p-2 rounded-3" href="/Huong-Dan-Size">
                                        <span class="nav-drop-icon bg-success bg-opacity-10 text-success"><i class="bi bi-rulers"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark small">Hướng dẫn chọn Size &amp; Cán</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Đo chu vi cán G5/G6 &amp; Size giày</small>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-3 p-2 rounded-3" href="/Tra-Cuu-Don-Hang">
                                        <span class="nav-drop-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-box-seam-fill"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark small">Tra cứu tiến độ đơn hàng</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Kiểm tra lộ trình theo Mã / SĐT</small>
                                        </div>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-3 p-2 rounded-3" asp-controller="News" asp-action="Index">
                                        <span class="nav-drop-icon bg-info bg-opacity-10 text-info"><i class="bi bi-journal-richtext"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark small">Cẩm nang &amp; Tin tức cầu lông</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Kỹ thuật đánh cầu &amp; Đánh giá vợt</small>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li>
                            <a class="pro-nav-link @(activeController == "Contact" ? "active" : "")" 
                               asp-controller="Contact" asp-action="Index">
                                Liên hệ
                            </a>
                        </li>
                    </ul>

                    @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                    {
                        <div class="ms-2 flex-shrink-0">
                            <a class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill text-decoration-none fw-bold small d-inline-flex align-items-center gap-1" 
                               asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-shield-lock-fill"></i>
                                <span>Quản trị</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Mobile Menu Dropdown (Compact 2-Column App Grid) -->
            <div class="collapse navbar-collapse d-lg-none py-3 border-top" id="mobileNavPro">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border text-decoration-none text-dark fw-bold small" href="/Danh-Muc?cat=vot">
                            <i class="bi bi-trophy-fill text-danger"></i> Vợt cầu lông
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border text-decoration-none text-dark fw-bold small" href="/Danh-Muc?cat=giay">
                            <i class="bi bi-lightning-charge-fill text-warning"></i> Giày thi đấu
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border text-decoration-none text-dark fw-bold small" href="/Danh-Muc?cat=quan-ao">
                            <i class="bi bi-handbag-fill text-primary"></i> Trang phục
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-danger bg-opacity-10 border border-danger-subtle text-decoration-none text-danger fw-bold small" href="/Tu-Van-Chon-Vot">
                            <i class="bi bi-cpu-fill"></i> Tư vấn vợt AI
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle text-decoration-none text-primary fw-bold small" href="/Dang-Ky-Khoa-Hoc">
                            <i class="bi bi-mortarboard-fill"></i> Khóa học
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="d-flex align-items-center gap-2 p-2 rounded-3 bg-warning bg-opacity-10 border border-warning-subtle text-decoration-none text-dark fw-bold small" href="/Bang-Xep-Hang">
                            <i class="bi bi-award-fill text-warning"></i> BXH VĐV &amp; Vợt
                        </a>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 pt-2 border-top small">
                    <a class="btn btn-sm btn-light border rounded-pill fw-semibold" href="/Dich-Vu-Cang-Cuoc"><i class="bi bi-tools me-1 text-primary"></i>Căng cước 4 nút</a>
                    <a class="btn btn-sm btn-light border rounded-pill fw-semibold" href="/Huong-Dan-Size"><i class="bi bi-rulers me-1 text-success"></i>Chọn Size</a>
                    <a class="btn btn-sm btn-light border rounded-pill fw-semibold" href="/Tra-Cuu-Don-Hang"><i class="bi bi-box-seam-fill me-1 text-warning"></i>Tra cứu đơn</a>
                    <a class="btn btn-sm btn-light border rounded-pill fw-semibold" asp-controller="News" asp-action="Index"><i class="bi bi-journal-richtext me-1 text-info"></i>Cẩm nang</a>
                    <a class="btn btn-sm btn-light border rounded-pill fw-semibold" asp-controller="Contact" asp-action="Index"><i class="bi bi-telephone-fill me-1 text-danger"></i>Liên hệ</a>
                    @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Staff")))
                    {
                        <a class="btn btn-sm btn-dark rounded-pill fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-line-fill me-1"></i>Quản trị</a>
                    }
                </div>

                @if (User?.Identity?.IsAuthenticated != true)
                {
                    <div class="d-flex gap-2 pt-3 mt-3 border-top">
                        <a class="btn btn-outline-dark w-50 rounded-pill fw-bold" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a class="btn btn-dark w-50 rounded-pill fw-bold" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top">
                        <span class="fw-bold"><i class="bi bi-person-circle me-1"></i> @User.Identity!.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill fw-bold">Đăng xuất</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <partial name="_Footer" />

    <!-- 3. MOBILE BOTTOM NAVIGATION BAR (APP-LIKE) -->
    <nav class="mobile-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="bottom-nav-item @(activeController == "Home" ? "active" : "")">
            <span class="bottom-nav-icon"><i class="bi bi-house-door-fill"></i></span>
            <span>Trang chủ</span>
        </a>
        <a href="/Danh-Muc" class="bottom-nav-item @(activeController == "Catalog" ? "active" : "")">
            <span class="bottom-nav-icon"><i class="bi bi-grid-fill"></i></span>
            <span>Sản phẩm</span>
        </a>
        <a asp-controller="Cart" asp-action="Index" class="bottom-nav-item @(activeController == "Cart" ? "active" : "")">
            <span class="bottom-nav-icon"><i class="bi bi-cart3"></i></span>
            <span>Giỏ hàng</span>
            @if (totalCartCount > 0)
            {
                <span class="bottom-nav-badge">@(totalCartCount > 99 ? "99+" : totalCartCount.ToString())</span>
            }
        </a>
        <a asp-controller="News" asp-action="Index" class="bottom-nav-item @(activeController == "News" ? "active" : "")">
            <span class="bottom-nav-icon"><i class="bi bi-journal-richtext"></i></span>
            <span>Cẩm nang</span>
        </a>
        <a asp-controller="Account" asp-action="Login" class="bottom-nav-item @(activeController == "Account" ? "active" : "")">
            <span class="bottom-nav-icon"><i class="bi bi-person-fill"></i></span>
            <span>Tài khoản</span>
        </a>
    </nav>

    <!-- GLOBAL INTERACTIVE TOAST -->
    <div id="proToast" class="pro-toast">
        <span id="toastIcon"><i class="bi bi-check-circle-fill text-success"></i></span>
        <span id="toastMsg">Thông báo thành công</span>
    </div>

    <!-- 4. FLOATING UTILITY WIDGET (BACK TO TOP + CALL + CHATBOT) -->
    <div class="floating-widget-dock" id="floatingWidgetDock">
        <!-- Nút Quay về đầu trang -->
        <button type="button" class="fw-btn fw-btn-top" id="btnBackToTop" title="Quay về đầu trang" aria-label="Quay về đầu trang">
            <i class="bi bi-arrow-up-short fs-3"></i>
            <span class="fw-tooltip">Lên đầu trang</span>
        </button>

        <!-- Nút Gọi tư vấn -->
        <a href="tel:0900000000" class="fw-btn fw-btn-call" title="Gọi tư vấn miễn phí: 0900 000 000" aria-label="Gọi tư vấn">
            <span class="fw-pulse-ring"></span>
            <i class="bi bi-telephone-inbound-fill fs-5"></i>
            <span class="fw-tooltip">Gọi tư vấn: 0900 000 000</span>
        </a>

        <!-- Nút Mở Chatbot -->
        <button type="button" class="fw-btn fw-btn-chat" id="btnToggleChatbot" title="Chat với Trợ lý Tiêu Đao AI" aria-label="Mở Chatbot">
            <span class="fw-chat-badge" id="chatbotUnreadBadge">1</span>
            <i class="bi bi-chat-dots-fill fs-5" id="chatbotTriggerIcon"></i>
            <span class="fw-tooltip">Trợ lý AI 24/7</span>
        </button>
    </div>

    <!-- KHUNG CHATBOT TƯ VẤN THÔNG MINH -->
    <div class="pro-chatbot-window" id="proChatbotWindow" aria-hidden="true">
        <!-- Header Chatbot -->
        <div class="chatbot-header">
            <div class="d-flex align-items-center gap-2">
                <div class="chatbot-avatar">
                    <span><i class="bi bi-robot"></i></span>
                    <span class="chatbot-online-dot"></span>
                </div>
                <div>
                    <div class="chatbot-title">Trợ Lý Tiêu Đao AI</div>
                    <div class="chatbot-status">Trực tuyến • Tư vấn tồn kho thực tế</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <a href="tel:0900000000" class="chatbot-header-btn" title="Gọi trực tiếp Hotline">
                    <i class="bi bi-telephone-fill"></i>
                </a>
                <button type="button" class="chatbot-header-btn" id="btnCloseChatbot" title="Đóng cửa sổ chat">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <!-- Body tin nhắn -->
        <div class="chatbot-messages" id="chatbotMessages">
            <div class="chat-msg bot">
                <div class="chat-bubble">
                    Xin chào! <i class="bi bi-stars text-warning"></i> Mình là <strong>Trợ lý AI của Tiêu Đao Badminton</strong>.<br/>
                    Bạn đang cần tìm hiểu thông tin gì hôm nay? Hãy chọn chủ đề bên dưới hoặc nhập câu hỏi nhé!
                </div>
                <div class="chat-time">Vừa xong</div>
            </div>
        </div>

        <!-- Gợi ý câu hỏi nhanh (Quick Replies) -->
        <div class="chatbot-quick-replies" id="chatbotQuickReplies">
            <button type="button" class="quick-reply-chip" data-query="Tư vấn chọn vợt phù hợp"><i class="bi bi-trophy-fill me-1"></i> Tư vấn chọn vợt</button>
            <button type="button" class="quick-reply-chip" data-query="Bảng giá căng cước 4 nút"><i class="bi bi-tools me-1"></i> Giá căng cước</button>
            <button type="button" class="quick-reply-chip" data-query="Hướng dẫn chọn size giày"><i class="bi bi-rulers me-1"></i> Chọn size giày</button>
            <button type="button" class="quick-reply-chip" data-query="Tra cứu đơn hàng"><i class="bi bi-box-seam-fill me-1"></i> Tra cứu đơn</button>
            <button type="button" class="quick-reply-chip" data-query="Chính sách bảo hành & Freeship"><i class="bi bi-shield-check me-1"></i> Bảo hành & Ship</button>
            <button type="button" class="quick-reply-chip" data-query="Liên hệ hotline cửa hàng"><i class="bi bi-telephone-fill me-1"></i> Gặp nhân viên</button>
        </div>

        <!-- Ô nhập tin nhắn -->
        <form class="chatbot-input-bar" id="chatbotForm" onsubmit="handleChatbotSubmit(event)">
            <input type="text" id="chatbotInput" placeholder="Nhập câu hỏi (VD: vợt cho người mới...)" autocomplete="off" />
            <button type="submit" class="chatbot-send-btn" title="Gửi tin nhắn">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Scroll header & Back-to-top effect
        const btnBackToTop = document.getElementById('btnBackToTop');
        window.addEventListener('scroll', () => {
            const header = document.querySelector('.pro-header');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            }
            if (btnBackToTop) {
                if (window.scrollY > 300) {
                    btnBackToTop.classList.add('visible');
                } else {
                    btnBackToTop.classList.remove('visible');
                }
            }
        });

        // Back to top click
        btnBackToTop?.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Chatbot Widget Logic
        const chatbotWindow = document.getElementById('proChatbotWindow');
        const btnToggleChatbot = document.getElementById('btnToggleChatbot');
        const btnCloseChatbot = document.getElementById('btnCloseChatbot');
        const chatbotUnreadBadge = document.getElementById('chatbotUnreadBadge');
        const chatbotTriggerIcon = document.getElementById('chatbotTriggerIcon');
        const chatbotMessages = document.getElementById('chatbotMessages');
        const chatbotInput = document.getElementById('chatbotInput');

        function toggleChatbotWindow(forceClose = false) {
            if (!chatbotWindow) return;
            const isOpen = chatbotWindow.classList.contains('open');
            if (isOpen || forceClose) {
                chatbotWindow.classList.remove('open');
                chatbotWindow.setAttribute('aria-hidden', 'true');
                if (chatbotTriggerIcon) chatbotTriggerIcon.className = 'bi bi-chat-dots-fill fs-5';
            } else {
                chatbotWindow.classList.add('open');
                chatbotWindow.setAttribute('aria-hidden', 'false');
                if (chatbotUnreadBadge) chatbotUnreadBadge.classList.add('d-none');
                if (chatbotTriggerIcon) chatbotTriggerIcon.className = 'bi bi-chevron-down fs-5';
                setTimeout(() => chatbotInput?.focus(), 200);
            }
        }

        btnToggleChatbot?.addEventListener('click', () => toggleChatbotWindow(false));
        btnCloseChatbot?.addEventListener('click', () => toggleChatbotWindow(true));

        // Quick Reply Chips
        document.querySelectorAll('.quick-reply-chip').forEach(chip => {
            chip.addEventListener('click', function () {
                const query = this.getAttribute('data-query');
                if (query) {
                    sendUserChatMessage(query);
                }
            });
        });

        function handleChatbotSubmit(e) {
            e.preventDefault();
            if (!chatbotInput) return;
            const text = chatbotInput.value.trim();
            if (!text) return;
            chatbotInput.value = '';
            sendUserChatMessage(text);
        }

        function appendChatMessage(htmlContent, sender = 'bot') {
            if (!chatbotMessages) return;
            const now = new Date();
            const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            const msgDiv = document.createElement('div');
            msgDiv.className = `chat-msg ${sender}`;
            msgDiv.innerHTML = `
                <div class="chat-bubble">${htmlContent}</div>
                <div class="chat-time">${timeStr}</div>
            `;
            chatbotMessages.appendChild(msgDiv);
            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }

        const chatHistory = [];

        async function sendUserChatMessage(text) {
            // Escape user text safely
            const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            appendChatMessage(escaped, 'user');

            // Typing indicator
            const typingId = 'typing-' + Date.now();
            if (chatbotMessages) {
                const typingDiv = document.createElement('div');
                typingDiv.className = 'chat-msg bot';
                typingDiv.id = typingId;
                typingDiv.innerHTML = `<div class="chat-bubble typing-dots"><span></span><span></span><span></span></div>`;
                chatbotMessages.appendChild(typingDiv);
                chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
            }

            try {
                const response = await fetch('/api/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        history: chatHistory.slice(-6)
                    })
                });

                document.getElementById(typingId)?.remove();

                if (response.ok) {
                    const data = await response.json();
                    const replyHtml = data.reply || generateBotResponse(text);
                    appendChatMessage(replyHtml, 'bot');

                    chatHistory.push({ role: 'user', text: text });
                    chatHistory.push({ role: 'model', text: replyHtml.replace(/<[^>]*>?/gm, ' ') });
                } else {
                    appendChatMessage(generateBotResponse(text), 'bot');
                }
            } catch (err) {
                document.getElementById(typingId)?.remove();
                appendChatMessage(generateBotResponse(text), 'bot');
            }
        }

        function generateBotResponse(input) {
            const q = input.toLowerCase();

            if (q.includes('vợt') || q.includes('chọn vợt') || q.includes('người mới') || q.includes('công thủ') || q.includes('smash')) {
                return `<i class="bi bi-trophy-fill text-danger me-1"></i> <strong>Gợi ý chọn vợt cầu lông chuẩn:</strong><br/>
                • <strong>Người mới / Cổ tay vừa:</strong> Nên chọn vợt <strong>4U (80-84g)</strong>, thân dẻo hoặc trung bình để trợ lực tốt.<br/>
                • <strong>Chuyên công Smash:</strong> Chọn vợt nặng đầu (Head-Heavy >295mm).<br/>
                • <strong>Phản tạt / Đánh lưới:</strong> Chọn vợt nhẹ đầu hoặc cân bằng.<br/>
                <a href="/Tu-Van-Chon-Vot" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Trắc nghiệm chọn vợt AI ngay →</a>
                <a href="/Danh-Muc?cat=vot" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Xem danh sách vợt chính hãng →</a>`;
            }

            if (q.includes('cước') || q.includes('căng') || q.includes('đan') || q.includes('kg')) {
                return `<i class="bi bi-tools text-primary me-1"></i> <strong>Dịch vụ Căng Cước Điện Tử 4 Nút:</strong><br/>
                • <strong>Miễn phí công đan máy</strong> trị giá 60.000đ khi mua vợt tại shop!<br/>
                • <strong>Mức cân gợi ý:</strong> Người mới (9.5 - 10.5kg) • Phong trào (10.5 - 11.5kg) • Bán chuyên (12kg+).<br/>
                • Cước phổ biến: Yonex BG65 Ti, BG80 Power, Exbolt 63/65, Aerobite.<br/>
                <a href="/Dich-Vu-Cang-Cuoc" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Xem bảng giá cước & quy trình đan 15p →</a>`;
            }

            if (q.includes('giày') || q.includes('size') || q.includes('chân') || q.includes('áo') || q.includes('quần')) {
                return `<i class="bi bi-rulers text-success me-1"></i> <strong>Hướng dẫn chọn Size Giày & Trang Phục:</strong><br/>
                • Đo chiều dài bàn chân (cm) và cộng thêm <strong>0.5cm</strong> (trừ hao tất dày thi đấu).<br/>
                • Bàn chân bè ngang nên ưu tiên dòng <strong>Wide (3E/4E)</strong> để êm mũi chân.<br/>
                <a href="/Huong-Dan-Size" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Mở bảng quy đổi Size chuẩn →</a>
                <a href="/Danh-Muc?cat=giay" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Xem các mẫu giày giảm chấn →</a>`;
            }

            if (q.includes('đơn') || q.includes('tra cứu') || q.includes('vận chuyển') || q.includes('giao hàng')) {
                return `<i class="bi bi-box-seam-fill text-warning me-1"></i> <strong>Tra cứu đơn hàng & Vận chuyển:</strong><br/>
                • Giao siêu tốc nội thành <strong>2-4 giờ</strong>, toàn quốc 2-3 ngày.<br/>
                • Bạn có thể kiểm tra trạng thái đơn bằng <strong>Mã đơn hàng</strong> hoặc <strong>Số điện thoại</strong>.<br/>
                <a href="/Tra-Cuu-Don-Hang" class="chat-action-link"><i class="bi bi-arrow-right-circle-fill me-1"></i> Tra cứu tiến độ đơn hàng ngay →</a>`;
            }

            if (q.includes('bảo hành') || q.includes('freeship') || q.includes('đổi trả') || q.includes('chính sách') || q.includes('ship')) {
                return `<i class="bi bi-shield-check text-success me-1"></i> <strong>Chính sách Ưu đãi & Bảo hành:</strong><br/>
                • Cam kết <strong>100% Chính hãng</strong> (Yonex, Victor, Li-Ning, Mizuno, Kawasaki).<br/>
                • <strong>Freeship toàn quốc</strong> cho đơn hàng từ 499.000đ.<br/>
                • Đổi trả miễn phí trong <strong>7 ngày</strong> nếu có lỗi từ nhà sản xuất.`;
            }

            if (q.includes('liên hệ') || q.includes('hotline') || q.includes('nhân viên') || q.includes('địa chỉ') || q.includes('gọi') || q.includes('sđt')) {
                return `<i class="bi bi-telephone-fill text-danger me-1"></i> <strong>Thông tin Liên hệ Tiêu Đao Badminton:</strong><br/>
                • <strong>Hotline Tư vấn 24/7:</strong> <a href="tel:0900000000" class="fw-bold text-danger">0900 000 000</a><br/>
                • <strong>Địa chỉ:</strong> 123 Đường Cầu Lông, TP. Hồ Chí Minh (8:00 - 21:30)<br/>
                <a href="tel:0900000000" class="chat-action-link"><i class="bi bi-telephone-outbound-fill me-1"></i> Gọi ngay cho kỹ thuật viên →</a>
                <a href="/Contact" class="chat-action-link"><i class="bi bi-geo-alt-fill me-1"></i> Xem bản đồ cửa hàng →</a>`;
            }

            return `Cảm ơn câu hỏi của bạn! <i class="bi bi-chat-heart-fill text-danger"></i> Để được hỗ trợ nhanh và chính xác nhất về <strong>"${input}"</strong>, bạn có thể:<br/>
            • Khám phá <a href="/Tu-Van-Chon-Vot" class="fw-bold text-primary">Trợ lý Tư vấn Vợt AI</a> hoặc <a href="/Danh-Muc" class="fw-bold text-primary">Danh mục sản phẩm</a>.<br/>
            • Hoặc gọi trực tiếp Hotline <a href="tel:0900000000" class="fw-bold text-danger">0900 000 000</a> để kỹ thuật viên tư vấn 1-1 ngay nhé!`;
        }

        // Interactive Toast Function
        function showToast(message, iconHtml = '<i class="bi bi-check-circle-fill text-success"></i>') {
            const toast = document.getElementById('proToast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');
            if (toast && toastMsg) {
                toastMsg.innerText = message;
                if (toastIcon) toastIcon.innerHTML = iconHtml;
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3000);
            }
        }

        // Interactive Wishlist Toggle Function
        function toggleWishlist(productId, btnElement) {
            fetch('/Wishlist/Toggle?productId=' + productId, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, data.isAdded ? '<i class="bi bi-heart-fill text-danger"></i>' : '<i class="bi bi-heart"></i>');
                    const badge = document.getElementById('wishlistBadge');
                    if (badge) {
                        badge.innerText = data.count > 99 ? '99+' : data.count;
                        if (data.count > 0) {
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                    if (btnElement) {
                        if (data.isAdded) {
                            btnElement.classList.add('active');
                            btnElement.innerHTML = '<i class="bi bi-heart-fill"></i>';
                            btnElement.style.color = '#e11d48';
                        } else {
                            btnElement.classList.remove('active');
                            btnElement.innerHTML = '<i class="bi bi-heart"></i>';
                            btnElement.style.color = '';
                        }
                    }
                } else {
                    showToast(data.message || 'Lỗi xử lý yêu thích', '<i class="bi bi-exclamation-triangle-fill text-warning"></i>');
                }
            })
            .catch(err => {
                console.error('Error toggling wishlist:', err);
                showToast('Không thể kết nối đến máy chủ', '<i class="bi bi-exclamation-triangle-fill text-warning"></i>');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

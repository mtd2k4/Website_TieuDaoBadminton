@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-2">Liên hệ</h2>
            <p class="text-muted mb-4">
                Cần tư vấn vợt/giày/size quần áo? Nhắn shop hỗ trợ nhanh.
            </p>

            <div class="card p-3">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="fw-bold">📍</div>
                    <div>
                        <div class="fw-semibold">Địa chỉ</div>
                        <div class="text-muted">TP. Hồ Chí Minh (cập nhật địa chỉ của bạn)</div>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="fw-bold">📞</div>
                    <div>
                        <div class="fw-semibold">Hotline</div>
                        <div class="text-muted">0900 000 000</div>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="fw-bold">✉️</div>
                    <div>
                        <div class="fw-semibold">Email</div>
                        <div class="text-muted">support@tieudaobadminton.com</div>
                    </div>
                </div>
            </div>

            <div class="small text-muted mt-3">
                Giờ làm việc: 8:00 - 21:00 (T2 - CN)
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <h5 class="fw-semibold mb-3">Gửi tin nhắn</h5>

                <form>
                    <div class="mb-3">
                        <label class="form-label">Họ tên</label>
                        <input class="form-control" placeholder="Nhập họ tên..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input class="form-control" placeholder="Nhập số điện thoại..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung</label>
                        <textarea class="form-control" rows="5" placeholder="Bạn cần tư vấn gì?"></textarea>
                    </div>

                    <button type="button" class="btn btn-dark w-100">
                        Gửi (demo)
                    </button>

                    <div class="text-muted small mt-2">
                        * Form demo, nếu muốn lưu DB + gửi mail mình làm tiếp.
                    </div>
                </form>
            </div>

            <div class="card p-0 mt-3 overflow-hidden">
                <iframe src="https://www.google.com/maps?q=Ho%20Chi%20Minh%20City&output=embed"
                        width="100%" height="300" style="border:0;"
                        allowfullscreen="" loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</div>

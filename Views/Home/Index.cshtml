@model tieudaobadminton.ViewModels.HomeVM
@using tieudaobadminton.Helpers
@{
    var wishlistIds = Context.Session.GetObject<List<int>>("WISHLIST") ?? new List<int>();
    ViewData["Title"] = "Tổ Buôn Badminton - Hệ Thống Cầu Lông Chuyên Nghiệp";

    string GetVariantSummary(tieudaobadminton.Models.Product p)
    {
        if (p.Variants != null && p.Variants.Count > 0)
        {
            var sizes = p.Variants
                .Where(v => v.Stock > 0 && !string.IsNullOrWhiteSpace(v.Size) && v.Size.Trim() != "-")
                .Select(v => v.Size!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(4)
                .ToList();
            if (sizes.Count > 0)
                return string.Join(" | ", sizes) + " • SẴN HÀNG";
        }
        return "CHÍNH HÃNG • SẴN HÀNG";
    }

    int GetTotalStock(tieudaobadminton.Models.Product p)
    {
        return p.Variants?.Sum(v => v.Stock) ?? 0;
    }

    string GetColorHexDot(string? colorName)
    {
        var c = (colorName ?? "").ToLower().Trim();
        if (c.Contains("trắng") || c.Contains("white") || c.Contains("bạch")) return "#f8fafc";
        if (c.Contains("đen") || c.Contains("black") || c.Contains("huyền")) return "#0f172a";
        if (c.Contains("đỏ") || c.Contains("red") || c.Contains("cherry")) return "#ef4444";
        if (c.Contains("xanh navy") || c.Contains("navy") || c.Contains("đậm")) return "#1e3a8a";
        if (c.Contains("xanh dương") || c.Contains("cyan") || c.Contains("blue") || c.Contains("lam")) return "#0284c7";
        if (c.Contains("xanh lá") || c.Contains("lục") || c.Contains("chuối") || c.Contains("ngọc")) return "#10b981";
        if (c.Contains("vàng") || c.Contains("gold") || c.Contains("chớp")) return "#f59e0b";
        if (c.Contains("cam") || c.Contains("orange")) return "#f97316";
        if (c.Contains("hồng") || c.Contains("pink")) return "#ec4899";
        if (c.Contains("tím") || c.Contains("purple")) return "#8b5cf6";
        return "#64748b";
    }
}

<div class="container py-4">

    <!-- 1. PRO CHAMPIONSHIP BENTO HERO SECTION -->
    <section class="bento-hero-wrap">
        <div class="row g-4 align-items-stretch">
            <!-- Left Main Hero Card -->
            <div class="col-lg-7 col-xl-8">
                <div class="bento-hero-main">
                    <div class="hero-court-grid" aria-hidden="true"></div>

                    <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
                        <div class="col-xl-7">
                            <span class="bento-tag">
                                <i class="bi bi-trophy-fill text-warning me-1"></i>TỔ BUÔN BADMINTON • PRO SERIES 2026
                            </span>
